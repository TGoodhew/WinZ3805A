<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured device output (§11.1). Copied verbatim: .gitattributes keeps these files free of
         end-of-line conversion because the parser derives satellite columns from token positions,
         and MSBuild must not undo that on the way to the output folder. -->
    <Content Include="Fixtures\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinZ3805A.Device\WinZ3805A.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §9.5.3's numeric rules are pure string logic and are unit-tested (P0-20), but they live in
         the app project because they are presentation, not device behaviour. The file is compiled
         by link rather than reached through a ProjectReference: the app is a Windows-only WinExe on
         net10.0-windows10.0.26100.0, and referencing it would drag WinUI into a headless test run
         and force a TFM this project has no reason to carry. The linked file has no UI using at
         all, which is what makes this safe - if that ever stops being true, the build breaks here
         rather than silently passing. -->
    <Compile Include="..\..\src\WinZ3805A\Controls\ReadoutFormatter.cs"
             Link="Formatting\ReadoutFormatter.cs" />
    <Compile Include="..\..\src\WinZ3805A\Controls\MedallionRingMath.cs"
             Link="Controls\MedallionRingMath.cs" />
    <Compile Include="..\..\src\WinZ3805A\Controls\Severity.cs"
             Link="Controls\Severity.cs" />
    <Compile Include="..\..\src\WinZ3805A\Controls\ReceiverMode.cs"
             Link="Controls\ReceiverMode.cs" />
    <!-- §11.1's two signal-strength scales differ by a factor of five, so which one a reading is on
         is not a detail a control may guess. Split out of SatelliteStrengthBar precisely so it can
         be linked here: the control speaks WinUI, the scale is arithmetic. -->
    <Compile Include="..\..\src\WinZ3805A\Controls\SignalStrengthScale.cs"
             Link="Controls\SignalStrengthScale.cs" />

    <!-- Same reasoning for the session layer. §6.2 places these under the app's Services/, but
         neither touches a UI type: they compose the Device library, Channels, and TimeProvider.
         Linking keeps them testable against FakeTransport without the test project taking on
         WinUI. If a UI using ever appears in one of them, this build breaks - which is the point. -->
    <Compile Include="..\..\src\WinZ3805A\Services\ConnectionStatus.cs"
             Link="Services\ConnectionStatus.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\DeviceSessionService.cs"
             Link="Services\DeviceSessionService.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\ReceiverStateStore.cs"
             Link="Services\ReceiverStateStore.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\PollingService.cs"
             Link="Services\PollingService.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\Staleness.cs"
             Link="ViewModels\Staleness.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\DisplayTime.cs"
             Link="ViewModels\DisplayTime.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\MainViewModel.cs"
             Link="ViewModels\MainViewModel.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\OverviewViewModel.cs"
             Link="ViewModels\OverviewViewModel.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\SatellitesViewModel.cs"
             Link="ViewModels\SatellitesViewModel.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\PositionViewModel.cs"
             Link="ViewModels\PositionViewModel.cs" />

    <!-- P0-1's §10.12 dialog. The registry walk and the LocalSettings container behind these are
         Windows-only and stay in the app; what is linked is the part with the decisions in it -
         which port comes back selected after a refresh, what the progress line says on the fifth of
         eight probes, and which row of §9.11 a failure belongs to. -->
    <Compile Include="..\..\src\WinZ3805A\Services\SerialPortInfo.cs"
             Link="Services\SerialPortInfo.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\ConnectionPreferences.cs"
             Link="Services\ConnectionPreferences.cs" />
    <Compile Include="..\..\src\WinZ3805A\ViewModels\ConnectionViewModel.cs"
             Link="ViewModels\ConnectionViewModel.cs" />

    <!-- §12's composition root, or the half of it that can leave the app project. What is linked is
         the registration shape - one context per device key, never shared across keys, no static
         state - which is the part §12 actually constrains. The rest of Compose() reaches the
         registry and the user's profile and stays in App. -->
    <Compile Include="..\..\src\WinZ3805A\Services\DeviceContext.cs"
             Link="Services\DeviceContext.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\DeviceRegistration.cs"
             Link="Services\DeviceRegistration.cs" />

    <!-- §15 step 8's Details shell. The window is what talks to NavigationView; what is linked is
         the pane's contents as data - how many destinations there are, in what order, and which
         Ctrl+n reaches each - because §10.2's cap of eight plus Settings is a counting rule that a
         XAML item list cannot state and a reviewer cannot check by eye. -->
    <Compile Include="..\..\src\WinZ3805A\ViewModels\DetailsDestination.cs"
             Link="ViewModels\DetailsDestination.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\DetailsViewPreferences.cs"
             Link="Services\DetailsViewPreferences.cs" />

    <!-- P0-3's window-state persistence. The window is what talks to AppWindow and DisplayArea;
         what is linked is the decision it delegates - given a saved rectangle and the displays
         attached now, where does the window open? The display topologies that make that question
         worth asking (a monitor removed, a monitor at negative coordinates, a resolution reduced
         under the window) are reachable here and not on a bench with one screen. -->
    <Compile Include="..\..\src\WinZ3805A\Services\WindowPlacement.cs"
             Link="Services\WindowPlacement.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\WindowPlacementPolicy.cs"
             Link="Services\WindowPlacementPolicy.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\WindowSizing.cs"
             Link="Services\WindowSizing.cs" />
    <Compile Include="..\..\src\WinZ3805A\Services\LocalWindowPlacementStore.cs"
             Link="Services\LocalWindowPlacementStore.cs" />

    <!-- The preference store is linked because it no longer speaks WinRT. It was written over
         ApplicationData.Current.LocalSettings, which killed the process outright; a JSON file has
         no such problem and, unlike the container, can be round-tripped in a headless test. -->
    <Compile Include="..\..\src\WinZ3805A\Services\LocalConnectionPreferenceStore.cs"
             Link="Services\LocalConnectionPreferenceStore.cs" />
  </ItemGroup>

</Project>