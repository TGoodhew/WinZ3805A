<?xml version="1.0" encoding="utf-8" ?>

<!--
    §9.6 spacing scale and §9.3 corner radii.

    Base unit is 4 px and every spacing value in the application comes from this scale
    and nothing else. §9.13 item 4 makes the converse a defect: a Margin="13,7,13,9"
    anywhere is a bug, not a tweak. Keeping the scale as named resources rather than
    literals is what makes that reviewable.

    Three corner radii exist and no others — no 2, no 6, no 12, no 16. The circle is
    not a token because it belongs to exactly one control, the state medallion, and is
    expressed there as a CornerRadius equal to half the side.

    Both scales are theme-invariant, so this file has no theme dictionaries. Spacing
    that changed with the theme would make the same screen a different size in dark
    mode, which is a bug people spend a long time failing to reproduce.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- §9.6 — the 4 px scale, as scalars                             -->
    <!-- ============================================================ -->
    <x:Double x:Key="WzSpaceXxs">4</x:Double>
    <x:Double x:Key="WzSpaceXs">8</x:Double>
    <x:Double x:Key="WzSpaceSm">12</x:Double>
    <x:Double x:Key="WzSpaceMd">16</x:Double>
    <x:Double x:Key="WzSpaceLg">20</x:Double>
    <x:Double x:Key="WzSpaceXl">24</x:Double>
    <x:Double x:Key="WzSpaceXxl">32</x:Double>
    <x:Double x:Key="WzSpace3Xl">40</x:Double>
    <x:Double x:Key="WzSpace4Xl">48</x:Double>

    <!--
        The same scale as uniform Thickness values, because Margin and Padding cannot
        take a Double. A style that needs an asymmetric inset composes it from these
        numbers rather than inventing one.
    -->
    <Thickness x:Key="WzSpaceXxsThickness">4</Thickness>
    <Thickness x:Key="WzSpaceXsThickness">8</Thickness>
    <Thickness x:Key="WzSpaceSmThickness">12</Thickness>
    <Thickness x:Key="WzSpaceMdThickness">16</Thickness>
    <Thickness x:Key="WzSpaceLgThickness">20</Thickness>
    <Thickness x:Key="WzSpaceXlThickness">24</Thickness>
    <Thickness x:Key="WzSpaceXxlThickness">32</Thickness>
    <Thickness x:Key="WzSpace3XlThickness">40</Thickness>
    <Thickness x:Key="WzSpace4XlThickness">48</Thickness>

    <!-- Page margin: XL at Medium and Wide, Md at Compact (§9.6). -->
    <Thickness x:Key="WzPageMarginThickness">24</Thickness>
    <Thickness x:Key="WzPageMarginCompactThickness">16</Thickness>

    <!--
        §9.6 content max-width. Beyond this the content region centres rather than
        gaining columns: the satellite table and the trend charts are the only things
        that benefit from more width, and label-value pairs separated by a hand's width
        on an ultrawide are measurably worse to scan.
    -->
    <x:Double x:Key="WzContentMaxWidth">1320</x:Double>

    <!-- §9.5.3 prose measure — roughly 72 characters at WzBodyTextStyle. -->
    <x:Double x:Key="WzProseMaxWidth">640</x:Double>

    <!-- §9.6.1 breakpoints, so NavigationView is configured rather than hand-rolled. -->
    <x:Double x:Key="WzCompactModeThresholdWidth">640</x:Double>
    <x:Double x:Key="WzExpandedModeThresholdWidth">1024</x:Double>

    <!-- ============================================================ -->
    <!-- §9.3 — corner radius. These three, and nothing else.          -->
    <!-- ============================================================ -->
    <CornerRadius x:Key="WzControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="WzCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WzOverlayCornerRadius">8</CornerRadius>

    <!-- 1 px hairline. §9.2 makes this the only separator in high contrast. -->
    <Thickness x:Key="WzHairlineThickness">1</Thickness>

</ResourceDictionary>
