<?xml version="1.0" encoding="utf-8" ?>

<!--
    Default templates for the controls in Controls/. WinUI resolves DefaultStyleKey against
    Themes/Generic.xaml by convention, which is why this file is here rather than merged into
    App.xaml alongside the token dictionaries.

    Everything is {ThemeResource}, including the non-brush tokens. That is not only about theme
    switching: Generic.xaml is resolved when a template is applied rather than when the app's
    resources load, and ThemeResource is a run-time lookup that reaches the application dictionary
    reliably where StaticResource can be evaluated too early.

    No literal colour, size, or radius appears here. Every value is a §9 token.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls">

    <!-- =========================================================================== -->
    <!-- SeverityPill (§9.4.3, §9.10.2, P0-19)                                        -->
    <!--                                                                              -->
    <!-- The shape geometry is the point of this control. Each path is drawn in a      -->
    <!-- 12x12 box so the five are optically consistent, and the distinctions are      -->
    <!-- deliberately coarse - filled circle, triangle, hexagon, circled i, hollow     -->
    <!-- ring - because they have to survive being small, being greyscale, and being   -->
    <!-- seen from across a room.                                                      -->
    <!-- =========================================================================== -->

    <!-- The geometries now live in Themes/Shapes.xaml, which IS merged into                -->
    <!-- Application.Resources, so pages can use them too (#32). They still resolve from      -->
    <!-- here: ThemeResource lookup from a control template walks up to the application.      -->

    <Style TargetType="controls:SeverityPill">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <!--
            A11Y-5's 32 px pointer floor, which applies "at all times" and whose only recorded
            exception is §9.10.2's sky-plot markers. Measured at 73 x 28 on 28 Aug 2026 - the dot
            and its label are 20 px of line height inside XXS padding, which lands four short.

            Not every pill is a pointer target, but several carry a ToolTipService tooltip and any
            of them may gain one, so the floor lives on the control rather than on the sites that
            happen to need it today. That is the difference between a guarantee and a habit.

            Safe against §9.6.3's dense rows: no SeverityPill sits inside a DataTemplate, so this
            raises no table row. Check that again before putting one in a list.
        -->
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeverityPill">
                    <Border x:Name="PillRoot"
                            Background="Transparent"
                            CornerRadius="{ThemeResource WzControlCornerRadius}"
                            MinHeight="{TemplateBinding MinHeight}"
                            Padding="{ThemeResource WzSpaceXxsThickness}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceXxs}"
                                    VerticalAlignment="Center">
                            <!--
                                Raw to assistive technology: it duplicates the label for a sighted
                                reader and would otherwise be announced as an unnamed graphic. The
                                control's own AutomationProperties.Name carries the meaning.
                            -->
                            <Path x:Name="Shape"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Data="{ThemeResource WzShapeRing}"
                                  Fill="{ThemeResource WzNeutralBrush}" />
                            <TextBlock x:Name="Label"
                                       Style="{ThemeResource WzBodyTextStyle}"
                                       Foreground="{ThemeResource WzTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Text}" />
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <!--
                                No transitions on any of these. §9.8.2 gives severity changes
                                WzDurationInstant, and a severity that fades between colours is
                                movement in peripheral vision on a window left running for weeks.
                            -->
                            <VisualStateGroup x:Name="SeverityStates">
                                <VisualState x:Name="Neutral">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeRing}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Success">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeCircle}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzSuccessBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Caution">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeTriangle}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Critical">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeHexagon}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Info">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeInfo}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzInfoBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- SatelliteStrengthBar (§9.10.2, §11.1)                                        -->
    <!--                                                                              -->
    <!-- Bar plus number, never bar alone. The two scales it may be asked to draw      -->
    <!-- differ by a factor of five, so the number is what a reader can actually       -->
    <!-- trust, and an unknown scale draws no bar at all.                              -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:SatelliteStrengthBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SatelliteStrengthBar">
                    <Grid ColumnSpacing="{ThemeResource WzSpaceXs}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="PART_Bar"
                                     Grid.Column="0"
                                     MinWidth="60"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AccessibilityView="Raw"
                                     Foreground="{ThemeResource WzAccentFillBrush}" />

                        <!-- Tabular figures so a column of readings stays aligned (§9.5.3). -->
                        <TextBlock x:Name="PART_Value"
                                   Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- ConnectionStatusPill (§9.7.3, §9.10.2)                                       -->
    <!--                                                                              -->
    <!-- The title bar's centre content. It composes SeverityPill rather than drawing  -->
    <!-- its own indicator, which is what P0-19 requires and what leaves this control  -->
    <!-- with no way to express a colour of its own.                                   -->
    <!--                                                                              -->
    <!-- Deliberately quiet: transparent until pointed at. It sits in a 48 px bar for  -->
    <!-- weeks at a time, and a filled button there would read as the loudest thing on -->
    <!-- screen. It never dims with the rest of the bar on deactivation (§9.7.3).      -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:ConnectionStatusPill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{ThemeResource WzSpaceXsThickness}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ConnectionStatusPill">
                    <Border x:Name="PillRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{ThemeResource WzControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceXxs}"
                                    VerticalAlignment="Center">
                            <controls:SeverityPill Severity="{TemplateBinding Severity}"
                                                   Text="{TemplateBinding StateText}" />

                            <StackPanel x:Name="PART_PortGroup"
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource WzSpaceXxs}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                                           Foreground="{ThemeResource WzTextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="&#183;" />
                                <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{TemplateBinding PortName}" />
                            </StackPanel>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource WzSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource WzSurfacePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- ReadoutTile (§9.5.3, §9.10.2, P0-20)                                         -->
    <!--                                                                              -->
    <!-- The value and the reserve string share one Grid cell. The reserve is          -->
    <!-- invisible but still measured, so the cell is always as wide as the widest     -->
    <!-- value this quantity can produce and the layout never reflows as digits come   -->
    <!-- and go. See the alignment note below for why both are centred rather than    -->
    <!-- right-aligned, and what that trades away.                                     -->
    <!--                                                                              -->
    <!-- LABEL AND VALUE ARE BOTH CENTRED ON THE FIELD. The label was left-aligned    -->
    <!-- until 28 Aug 2026, which put it on a different axis from its own number: the  -->
    <!-- reserve for 1 PPS TI is wide enough for -9999.9, so the value sat far to the  -->
    <!-- right of the words naming it and the tile read as two unrelated pieces.       -->
    <!--                                                                              -->
    <!-- BOTH, and that is the whole point. Centring the caption alone looked no more  -->
    <!-- centred than before, because the value was still pinned to the right edge of  -->
    <!-- a reserve that is mostly empty: the two were centred on different things.     -->
    <!-- Two halves of a tile agree only when they share one axis, whichever it is.    -->
    <!--                                                                               -->
    <!-- WHAT THIS COSTS. §9.5.3 rule 2's reserved width still stops the tile          -->
    <!-- reflowing, and rule 1's tabular figures still stop the digits jostling, but a -->
    <!-- centred value shifts by half a character when the digit count changes - 7 to  -->
    <!-- 12, or -1.7 to -12.3. Right alignment is the only arrangement that holds the  -->
    <!-- ones column still. That was tried and read as pushed-away; this is the        -->
    <!-- deliberate trade, not an oversight.                                           -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:ReadoutTile">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!--
            The value's brush is a template binding rather than a literal in the template, so that
            §9.11's Stale state can dim a reading to WzTextSecondaryBrush without reaching inside
            the control (#320). The default here is what the three value runs used to hard-code.
            The label and the unit keep their own brushes: they are not the reading, and dimming a
            caption that was already secondary would say nothing.
        -->
        <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
        <!--
            TRANSPARENT AND NOT UNSET. An unset Background is null, which is not hit-testable at
            all, so §9.7.4's right-click menu (#320) was attached to a control the pointer could
            never reach — measured, not guessed: right-clicking the readout produced nothing while
            the same menu on a plain TextBlock beside it opened. This is the identical trap the
            §9.6.3 hit-target work recorded for Border, arriving on a different control.
        -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ReadoutTile">
                    <StackPanel Background="{TemplateBinding Background}"
                                Spacing="{ThemeResource WzSpaceXxs}">

                        <TextBlock x:Name="LabelText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Text="{TemplateBinding Label}" />

                        <!--
                            Stretch, not Left. The Grid is sized by the reserve, and the StackPanel
                            is sized by whichever of the label and the reserve is wider; stretching
                            makes both children span that full width so the two right edges are the
                            same edge. Left-aligning the Grid was what let the axes diverge.
                        -->
                        <!--
                            Two columns: the number, and the unit beside it. The unit is OUTSIDE the
                            aligned box, which is what lets the caption centre over the digits rather
                            than over "-7.2 ns" - the caption named the quantity, and the quantity is
                            the number.

                            §9.5.3 rule 3 already treats the unit as typographically separate; this
                            makes it structurally separate too, and the amendment there records the
                            wording change from "a separate Run" to "a separate element".
                        -->
                        <!--
                            THE DECIMAL POINT IS THE AXIS, and the caption is centred on it.

                            §9.5.3 rule 5 asks for alignment on the decimal separator and this is
                            what that means for a single readout. Two properties fall out of it that
                            no other arrangement gives at once:

                            - the decimal point NEVER MOVES. Integer digits grow leftward into the
                              reserved column, so 5.9 becoming 12.3 shifts nothing the eye is resting
                              on. Centring the whole number moved it by half a character each time.
                            - the unit sits a hair space from the last digit, always. It follows the
                              fractional part, whose width is fixed per quantity by rule 6, so it can
                              neither drift nor be stranded at the far edge of a wide reserve.

                            Column 0 holds the sign and integer digits, right-aligned against the
                            axis. Column 1 holds the fractional digits and the unit, left-aligned
                            from it. The invisible reserve sets column 0's width, so the axis is
                            fixed by the widest number this quantity can produce rather than by the
                            one showing.
                        -->
                        <Grid x:Name="PART_ValueGrid" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--
                                Opacity 0 rather than Visibility Collapsed: a collapsed element is
                                not measured, and being measured is this element's entire job. Raw
                                and not hit-testable so it reaches neither assistive technology nor
                                the pointer. It reserves the integer side only - that is what fixes
                                the axis.
                            -->
                            <TextBlock x:Name="PART_ReserveText"
                                       Grid.Column="0"
                                       Style="{ThemeResource WzReadoutMediumTextStyle}"
                                       HorizontalAlignment="Right"
                                       Opacity="0"
                                       IsHitTestVisible="False"
                                       AutomationProperties.AccessibilityView="Raw">
                                <Run x:Name="PART_ReserveValueRun" />
                            </TextBlock>

                            <TextBlock x:Name="PART_ValueText"
                                       Grid.Column="0"
                                       Style="{ThemeResource WzReadoutMediumTextStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Right"
                                       AutomationProperties.AccessibilityView="Raw">
                                <Run x:Name="PART_ValueRun" />
                            </TextBlock>

                            <!--
                                The separator is its own element so the axis can be MEASURED rather
                                than estimated. Aligning the caption to the boundary between the
                                columns put it on the left edge of the point rather than its middle,
                                which is visibly off at 56 px; half of this block's width is the
                                correction, and it costs nothing to read exactly.
                            -->
                            <TextBlock x:Name="PART_PointText"
                                       Grid.Column="1"
                                       Style="{ThemeResource WzReadoutMediumTextStyle}"
                                       Foreground="{TemplateBinding Foreground}"
                                       AutomationProperties.AccessibilityView="Raw">
                                <Run x:Name="PART_PointRun" />
                            </TextBlock>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <TextBlock x:Name="PART_FractionText"
                                           Style="{ThemeResource WzReadoutMediumTextStyle}"
                                           Foreground="{TemplateBinding Foreground}"
                                           AutomationProperties.AccessibilityView="Raw">
                                    <Run x:Name="PART_FractionRun" />
                                </TextBlock>

                                <!--
                                    The unit carries the READOUT'S style and shrinks its runs rather
                                    than being a small TextBlock. VerticalAlignment aligns line BOXES,
                                    not baselines, so a 12 px block against a 56 px one sits below the
                                    digits by the whole descender - which is what an earlier attempt
                                    did. Sharing the style shares the line height, and the smaller
                                    runs sit on the shared baseline for free.

                                    The hair space (rule 3) is at the unit's size too. It used to
                                    inherit the readout's, so it was a hair space set at 56 px beside
                                    a 12 px unit - the reason the gap read as far too wide.
                                -->
                                <TextBlock x:Name="PART_UnitText"
                                           Style="{ThemeResource WzReadoutMediumTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                                           AutomationProperties.AccessibilityView="Raw">
                                    <Run x:Name="PART_SpacerRun" FontSize="12" FontWeight="Normal" />
                                    <Run x:Name="PART_UnitRun" FontSize="12" FontWeight="Normal" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- StatusMedallion (§9.10.2, §10.3, P0-18)                                      -->
    <!--                                                                              -->
    <!-- The circle is reserved to this control alone (§9.3). Nothing here animates:   -->
    <!-- §9.8.2 gives the ring redraw WzDurationInstant and §9.13 item 7 forbids it    -->
    <!-- pulsing in holdover. It changes colour, glyph and shape at once instead,      -->
    <!-- which is louder because everything else on the window is still.               -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:StatusMedallion">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <!--
            0 in Light and Dark, 2 in HighContrast. This is how §9.10.2's high-contrast rule
            reaches the control without it asking the system what theme is in force.
        -->
        <Setter Property="PlainRingThickness" Value="{ThemeResource WzMedallionPlainRingThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusMedallion">
                    <Grid x:Name="MedallionRoot" Background="Transparent">

                        <!-- The face. A circle, and the only one in the application. -->
                        <Ellipse x:Name="Face"
                                 Fill="{ThemeResource WzCardFillBrush}"
                                 Stroke="{ThemeResource WzStrokeSubtleBrush}"
                                 StrokeThickness="{ThemeResource WzHairlineThickness}" />

                        <!--
                            Raw to assistive technology, per §9.10.2: the ring is a qualitative
                            restatement of a number the control already announces in its name, and
                            sixty unnamed marks would bury the meaning rather than add to it.
                        -->
                        <Path x:Name="PART_Ring"
                              Stroke="{ThemeResource WzNeutralBrush}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              AutomationProperties.AccessibilityView="Raw" />

                        <!-- Replaces the sparkline under high contrast. -->
                        <Ellipse x:Name="PART_PlainRing"
                                 Margin="{ThemeResource WzSpaceXxsThickness}"
                                 Stroke="{ThemeResource WzTextPrimaryBrush}"
                                 Visibility="Collapsed"
                                 AutomationProperties.AccessibilityView="Raw" />

                        <TextBlock x:Name="Glyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                   Foreground="{ThemeResource WzNeutralBrush}"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Text="&#xE8CD;" />

                        <!--
                            §9.9's custom holdover icon, which is the one mode with no adequate
                            Fluent glyph (#320). Sized and shown by UpdateCentre rather than by a
                            visual state: that method already sets Glyph.Visibility as a LOCAL
                            value to swap in the satellite count, and a local value beats a
                            VisualState setter - so a state that tried to hide the font glyph here
                            would be silently overruled the moment the centre updated.

                            Stretch Uniform and not None, because the geometry is authored on
                            §9.9's 16 px grid while the medallion draws it at 22, 34 or 56.
                        -->
                        <Path x:Name="GlyphPath"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Visibility="Collapsed"
                              Fill="{ThemeResource WzNeutralBrush}"
                              AutomationProperties.AccessibilityView="Raw" />

                        <!--
                            §9.6.2's tracked-satellite count, shown INSTEAD of the glyph in compact
                            (#279). G1 asks for mode and count legible at two metres, and §9.5.3's
                            token table already describes this centre as holding a value.

                            A separate element rather than reusing Glyph, because the two want
                            different fonts: the glyph is Segoe Fluent Icons and the count is lining
                            figures in the body face. Every mode state below sets BOTH foregrounds,
                            so the two can never disagree about the state's colour.

                            Raw to automation, like the glyph. The medallion's automation name is
                            built as a whole sentence in code and already carries the count; a
                            screen reader finding a bare numeral here as well would hear it twice.
                        -->
                        <TextBlock x:Name="Count"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource WzNeutralBrush}"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Visibility="Collapsed" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ModeStates">
                                <VisualState x:Name="Locked">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE73E;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzSuccessBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzSuccessBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzSuccessBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Recovering">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE72C;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Waiting">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE769;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Holdover">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE7BA;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCriticalBrush}" />
                                        <Setter Target="GlyphPath.Fill" Value="{ThemeResource WzCriticalBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzCriticalBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PowerUp">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE823;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Off">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE7E8;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disconnected">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE8CD;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="Count.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--
                                The glyph carries no FontSize here. StatusMedallion.ApplySize sets it
                                from MedallionRingMath.GlyphSize, which is 56/160 of the diameter: 56
                                in the 160 px medallion the main window shows normally, 34 in the
                                Overview page's 96 px one, and 22 in the 64 px one §10.3's compact
                                mode shows — a ratio rather than a table, so a size added later
                                cannot arrive without a glyph size (#48).

                                §9.9's icon table still gives the glyph two fixed sizes, 40 compact
                                and 56 standard, and §10.3's compact wireframe draws "glyph 40 px".
                                The control does not implement the 40: at 64 px the ratio gives 22.
                                That mismatch between the table and the control was surfaced by the
                                #316 audit and is recorded here, not resolved.
                            -->
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- FieldErrorText (§9.11)                                                       -->
    <!--                                                                              -->
    <!-- Glyph plus text plus the field's own border, never border colour alone. The   -->
    <!-- caller sets the border; this is the other two thirds of the rule.             -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:FieldErrorText">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FieldErrorText">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{ThemeResource WzSpaceXxs}">
                        <!--
                            Raw to assistive technology: the control carries the message on its own
                            AutomationProperties.Name, and an unnamed glyph beside it would be
                            announced as a second, meaningless element.
                        -->
                        <FontIcon Glyph="&#xEA39;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Foreground="{ThemeResource WzCriticalBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{TemplateBinding Message}"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzCriticalBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- =========================================================================== -->
    <!-- TrendChart (§9.10.2, §9.4.4, P1-1)                                            -->
    <!--                                                                              -->
    <!-- The plot is drawn into PART_Surface in code: one vertical stroke per pixel    -->
    <!-- column, from that column's minimum to its maximum, plus a zero line and three -->
    <!-- axis labels. What is here is the surface it draws on.                         -->
    <!--                                                                              -->
    <!-- Only an implicit style: a keyed one declared here would resolve for nothing,  -->
    <!-- because Generic.xaml is loaded for a control's default style and is not       -->
    <!-- merged into Application.Resources.                                            -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:TrendChart">
        <!--
            Not a tab stop, like every other non-interactive control in this file (A11Y-1, A11Y-2,
            #22). Control.IsTabStop defaults to True, so a custom control is in the tab order unless
            it says otherwise, and this was the one that never did: Tab landed on both charts on the
            Timing page and nothing was drawn, because there is no focus visual and nothing to give
            focus to. A stop that neither responds nor indicates is a hole a keyboard user falls
            into - focus vanishes, and the next Tab moves on.

            The alternative, a focus visual, would be decoration on a control with no keyboard model.
            SkyPlotControl is a tab stop because its arrow keys do something; this draws a picture.
            Nothing is lost: the range selector beside it is focusable, the CSV export button is, and
            AutomationProperties.Name still reaches a screen reader, which does not navigate by Tab.
        -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TrendChart">
                    <Border Background="{ThemeResource WzLayerFillBrush}"
                            CornerRadius="{ThemeResource WzCardCornerRadius}"
                            Padding="{ThemeResource WzSpaceXsThickness}">
                        <!--
                            No ClipToBounds: that is a WPF property and a XAML compiler error here.
                            The drawing clamps its own coordinates instead, which it has to do
                            anyway - a column whose extreme is off the axis must stop at the edge
                            rather than be hidden by a clip.
                        -->
                        <Canvas x:Name="PART_Surface" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SkyPlotControl (§10.5, §9.10.2, P0-9)                                        -->
    <!--                                                                              -->
    <!-- The plot itself is drawn into PART_Canvas in code: circles, a cross, some     -->
    <!-- text and one Button per satellite. What is here is the frame around it and    -->
    <!-- the marker's own shape, which is a Style rather than a per-marker template    -->
    <!-- so every marker is the same shape by construction.                            -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:SkyPlotControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SkyPlotControl">
                    <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                        <!--
                            Square, and sized by the control from its own width capped at
                            MaxPlotSize. A polar plot on a non-square surface is an ellipse, and
                            an ellipse read as a circle is a plot that lies about azimuth.
                        -->
                        <Grid x:Name="PART_Surface">
                            <Canvas x:Name="PART_Canvas" />
                        </Grid>

                        <!--
                            §10.5's legend, minus its third entry. The wireframe offers
                            "✱ trying", but the receiver's Not Tracking table carries no status
                            column, so acquiring and trying are not on the wire - see
                            SkyPlotMarkerKind. Below the mask is derivable and takes its place.
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceMd}"
                                    AutomationProperties.AccessibilityView="Raw">
                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource WzSequential5Brush}"
                                         Stroke="{ThemeResource WzStrokeDefaultBrush}"
                                         StrokeThickness="1" />
                                <TextBlock Text="tracked"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource WzCardFillBrush}"
                                         Stroke="{ThemeResource WzTextSecondaryBrush}"
                                         StrokeThickness="1.5" />
                                <TextBlock Text="predicted"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Opacity="0.55"
                                         Fill="{ThemeResource WzCardFillBrush}"
                                         Stroke="{ThemeResource WzTextTertiaryBrush}"
                                         StrokeThickness="1.5" />
                                <TextBlock Text="below mask"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Rectangle Width="14" Height="2"
                                           VerticalAlignment="Center"
                                           Fill="{ThemeResource WzCautionBrush}" />
                                <TextBlock x:Name="PART_MaskLabel"
                                           Text="elevation mask"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
