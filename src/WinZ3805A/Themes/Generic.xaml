<?xml version="1.0" encoding="utf-8" ?>

<!--
    Default templates for the controls in Controls/. WinUI resolves DefaultStyleKey against
    Themes/Generic.xaml by convention, which is why this file is here rather than merged into
    App.xaml alongside the token dictionaries.

    Everything is {ThemeResource}, including the non-brush tokens. That is not only about theme
    switching: Generic.xaml is resolved when a template is applied rather than when the app's
    resources load, and ThemeResource is a run-time lookup that reaches the application dictionary
    reliably where StaticResource can be evaluated too early.

    No literal colour, size, or radius appears here. Every value is a §9 token.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls">

    <!-- =========================================================================== -->
    <!-- SeverityPill (§9.4.3, §9.10.2, P0-19)                                        -->
    <!--                                                                              -->
    <!-- The shape geometry is the point of this control. Each path is drawn in a      -->
    <!-- 12x12 box so the five are optically consistent, and the distinctions are      -->
    <!-- deliberately coarse - filled circle, triangle, hexagon, circled i, hollow     -->
    <!-- ring - because they have to survive being small, being greyscale, and being   -->
    <!-- seen from across a room.                                                      -->
    <!-- =========================================================================== -->

    <x:String x:Key="WzShapeCircle">M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z</x:String>
    <x:String x:Key="WzShapeTriangle">M 6,0 L 12,11 L 0,11 Z</x:String>
    <x:String x:Key="WzShapeHexagon">M 6,0 L 11.2,3 L 11.2,9 L 6,12 L 0.8,9 L 0.8,3 Z</x:String>
    <!-- F0 is the even-odd fill rule, which is what knocks the glyph out of the disc. -->
    <x:String x:Key="WzShapeInfo">F0 M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z M 5.1,5.1 L 6.9,5.1 L 6.9,9.4 L 5.1,9.4 Z M 5.1,2.4 L 6.9,2.4 L 6.9,4.1 L 5.1,4.1 Z</x:String>
    <x:String x:Key="WzShapeRing">F0 M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z M 2.4,6 A 3.6,3.6 0 1 0 9.6,6 A 3.6,3.6 0 1 0 2.4,6 Z</x:String>

    <Style TargetType="controls:SeverityPill">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SeverityPill">
                    <Border x:Name="PillRoot"
                            Background="Transparent"
                            CornerRadius="{ThemeResource WzControlCornerRadius}"
                            Padding="{ThemeResource WzSpaceXxsThickness}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceXxs}"
                                    VerticalAlignment="Center">
                            <!--
                                Raw to assistive technology: it duplicates the label for a sighted
                                reader and would otherwise be announced as an unnamed graphic. The
                                control's own AutomationProperties.Name carries the meaning.
                            -->
                            <Path x:Name="Shape"
                                  Width="12"
                                  Height="12"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Data="{ThemeResource WzShapeRing}"
                                  Fill="{ThemeResource WzNeutralBrush}" />
                            <TextBlock x:Name="Label"
                                       Style="{ThemeResource WzBodyTextStyle}"
                                       Foreground="{ThemeResource WzTextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Text}" />
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <!--
                                No transitions on any of these. §9.8.2 gives severity changes
                                WzDurationInstant, and a severity that fades between colours is
                                movement in peripheral vision on a window left running for weeks.
                            -->
                            <VisualStateGroup x:Name="SeverityStates">
                                <VisualState x:Name="Neutral">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeRing}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Success">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeCircle}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzSuccessBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Caution">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeTriangle}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Critical">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeHexagon}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Info">
                                    <VisualState.Setters>
                                        <Setter Target="Shape.Data" Value="{ThemeResource WzShapeInfo}" />
                                        <Setter Target="Shape.Fill" Value="{ThemeResource WzInfoBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- SatelliteStrengthBar (§9.10.2, §11.1)                                        -->
    <!--                                                                              -->
    <!-- Bar plus number, never bar alone. The two scales it may be asked to draw      -->
    <!-- differ by a factor of five, so the number is what a reader can actually       -->
    <!-- trust, and an unknown scale draws no bar at all.                              -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:SatelliteStrengthBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SatelliteStrengthBar">
                    <Grid ColumnSpacing="{ThemeResource WzSpaceXs}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="PART_Bar"
                                     Grid.Column="0"
                                     MinWidth="60"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AccessibilityView="Raw"
                                     Foreground="{ThemeResource WzAccentFillBrush}" />

                        <!-- Tabular figures so a column of readings stays aligned (§9.5.3). -->
                        <TextBlock x:Name="PART_Value"
                                   Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   MinWidth="28"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- ConnectionStatusPill (§9.7.3, §9.10.2)                                       -->
    <!--                                                                              -->
    <!-- The title bar's centre content. It composes SeverityPill rather than drawing  -->
    <!-- its own indicator, which is what P0-19 requires and what leaves this control  -->
    <!-- with no way to express a colour of its own.                                   -->
    <!--                                                                              -->
    <!-- Deliberately quiet: transparent until pointed at. It sits in a 48 px bar for  -->
    <!-- weeks at a time, and a filled button there would read as the loudest thing on -->
    <!-- screen. It never dims with the rest of the bar on deactivation (§9.7.3).      -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:ConnectionStatusPill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{ThemeResource WzSpaceXsThickness}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ConnectionStatusPill">
                    <Border x:Name="PillRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{ThemeResource WzControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceXxs}"
                                    VerticalAlignment="Center">
                            <controls:SeverityPill Severity="{TemplateBinding Severity}"
                                                   Text="{TemplateBinding StateText}" />

                            <StackPanel x:Name="PART_PortGroup"
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource WzSpaceXxs}"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                                           Foreground="{ThemeResource WzTextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="&#183;" />
                                <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Text="{TemplateBinding PortName}" />
                            </StackPanel>
                        </StackPanel>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource WzSurfaceHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillRoot.Background" Value="{ThemeResource WzSurfacePressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- ReadoutTile (§9.5.3, §9.10.2, P0-20)                                         -->
    <!--                                                                              -->
    <!-- The value and the reserve string share one Grid cell. The reserve is          -->
    <!-- invisible but still measured, so the cell is always as wide as the widest     -->
    <!-- value this quantity can produce and the layout never reflows as digits come   -->
    <!-- and go. Both are right-aligned, so the ones column stays put (§9.5.3 rule 5). -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:ReadoutTile">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ReadoutTile">
                    <StackPanel Spacing="{ThemeResource WzSpaceXxs}">

                        <TextBlock x:Name="LabelText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="{TemplateBinding Label}" />

                        <Grid HorizontalAlignment="Left">
                            <!--
                                Opacity 0 rather than Visibility Collapsed: a collapsed element is
                                not measured, and being measured is this element's entire job.
                                Raw and not hit-testable so it reaches neither assistive technology
                                nor the pointer.
                            -->
                            <TextBlock x:Name="PART_ReserveText"
                                       Style="{ThemeResource WzReadoutMediumTextStyle}"
                                       Opacity="0"
                                       IsHitTestVisible="False"
                                       AutomationProperties.AccessibilityView="Raw">
                                <Run x:Name="PART_ReserveValueRun" />
                                <Run x:Name="PART_ReserveSpacerRun" />
                                <Run x:Name="PART_ReserveUnitRun"
                                     FontSize="12"
                                     FontWeight="Normal" />
                            </TextBlock>

                            <TextBlock x:Name="PART_ValueText"
                                       Style="{ThemeResource WzReadoutMediumTextStyle}"
                                       Foreground="{ThemeResource WzTextPrimaryBrush}"
                                       HorizontalAlignment="Right"
                                       AutomationProperties.AccessibilityView="Raw">
                                <Run x:Name="PART_ValueRun" />
                                <!--
                                    The unit is a separate Run in caption size and secondary colour,
                                    after a hair space (§9.5.3 rule 3). It never changes, so giving
                                    it the weight of the digits would make the digits harder to find.
                                    Never bolded, never part of the numeric string.
                                -->
                                <Run x:Name="PART_SpacerRun" />
                                <Run x:Name="PART_UnitRun"
                                     FontSize="12"
                                     FontWeight="Normal"
                                     Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </TextBlock>
                        </Grid>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Small">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ValueText.Style" Value="{ThemeResource WzReadoutSmallTextStyle}" />
                                        <Setter Target="PART_ReserveText.Style" Value="{ThemeResource WzReadoutSmallTextStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Medium">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ValueText.Style" Value="{ThemeResource WzReadoutMediumTextStyle}" />
                                        <Setter Target="PART_ReserveText.Style" Value="{ThemeResource WzReadoutMediumTextStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Large">
                                    <VisualState.Setters>
                                        <Setter Target="PART_ValueText.Style" Value="{ThemeResource WzReadoutLargeTextStyle}" />
                                        <Setter Target="PART_ReserveText.Style" Value="{ThemeResource WzReadoutLargeTextStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- StatusMedallion (§9.10.2, §10.3, P0-18)                                      -->
    <!--                                                                              -->
    <!-- The circle is reserved to this control alone (§9.3). Nothing here animates:   -->
    <!-- §9.8.2 gives the ring redraw WzDurationInstant and §9.13 item 7 forbids it    -->
    <!-- pulsing in holdover. It changes colour, glyph and shape at once instead,      -->
    <!-- which is louder because everything else on the window is still.               -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:StatusMedallion">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <!--
            0 in Light and Dark, 2 in HighContrast. This is how §9.10.2's high-contrast rule
            reaches the control without it asking the system what theme is in force.
        -->
        <Setter Property="PlainRingThickness" Value="{ThemeResource WzMedallionPlainRingThickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusMedallion">
                    <Grid x:Name="MedallionRoot" Background="Transparent">

                        <!-- The face. A circle, and the only one in the application. -->
                        <Ellipse x:Name="Face"
                                 Fill="{ThemeResource WzCardFillBrush}"
                                 Stroke="{ThemeResource WzStrokeSubtleBrush}"
                                 StrokeThickness="{ThemeResource WzHairlineThickness}" />

                        <!--
                            Raw to assistive technology, per §9.10.2: the ring is a qualitative
                            restatement of a number the control already announces in its name, and
                            sixty unnamed marks would bury the meaning rather than add to it.
                        -->
                        <Path x:Name="PART_Ring"
                              Stroke="{ThemeResource WzNeutralBrush}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              AutomationProperties.AccessibilityView="Raw" />

                        <!-- Replaces the sparkline under high contrast. -->
                        <Ellipse x:Name="PART_PlainRing"
                                 Margin="{ThemeResource WzSpaceXxsThickness}"
                                 Stroke="{ThemeResource WzTextPrimaryBrush}"
                                 Visibility="Collapsed"
                                 AutomationProperties.AccessibilityView="Raw" />

                        <TextBlock x:Name="Glyph"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                   Foreground="{ThemeResource WzNeutralBrush}"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Text="&#xE8CD;" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ModeStates">
                                <VisualState x:Name="Locked">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE73E;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzSuccessBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzSuccessBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Recovering">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE72C;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Waiting">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE769;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCautionBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCautionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Holdover">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE7BA;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzCriticalBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzCriticalBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PowerUp">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE823;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Off">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE7E8;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disconnected">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.Text" Value="&#xE8CD;" />
                                        <Setter Target="Glyph.Foreground" Value="{ThemeResource WzNeutralBrush}" />
                                        <Setter Target="PART_Ring.Stroke" Value="{ThemeResource WzNeutralBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <!--
                                §9.9's icon table gives the medallion glyph two sizes: 40 compact and
                                56 standard. 56 is the 160 px medallion the main window shows normally;
                                40 is the 64 px one it shows in §10.3's compact mode.

                                Compact was 28 until #54, which is when compact mode acquired a
                                keyboard route and anyone was likely to use it. 40 in a 64 px
                                medallion is proportionally larger than 56 in a 160 px one, and that
                                is deliberate rather than an oversight in the table: compact mode is
                                the ambient-legibility mode, and G1 measures it at two metres.

                                Standard, at 36, is a size nothing currently asks for. It is left
                                alone rather than adjusted to match a rule §9.9 does not state for it.
                            -->
                            <VisualStateGroup x:Name="SizeStates">
                                <VisualState x:Name="Compact">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.FontSize" Value="40" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Standard">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.FontSize" Value="36" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Large">
                                    <VisualState.Setters>
                                        <Setter Target="Glyph.FontSize" Value="56" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- FieldErrorText (§9.11)                                                       -->
    <!--                                                                              -->
    <!-- Glyph plus text plus the field's own border, never border colour alone. The   -->
    <!-- caller sets the border; this is the other two thirds of the rule.             -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:FieldErrorText">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:FieldErrorText">
                    <StackPanel Orientation="Horizontal"
                                Spacing="{ThemeResource WzSpaceXxs}">
                        <!--
                            Raw to assistive technology: the control carries the message on its own
                            AutomationProperties.Name, and an unnamed glyph beside it would be
                            announced as a second, meaningless element.
                        -->
                        <FontIcon Glyph="&#xEA39;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Foreground="{ThemeResource WzCriticalBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{TemplateBinding Message}"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzCriticalBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================================== -->
    <!-- =========================================================================== -->
    <!-- TrendChart (§9.10.2, §9.4.4, P1-1)                                            -->
    <!--                                                                              -->
    <!-- The plot is drawn into PART_Surface in code: one vertical stroke per pixel    -->
    <!-- column, from that column's minimum to its maximum, plus a zero line and three -->
    <!-- axis labels. What is here is the surface it draws on.                         -->
    <!--                                                                              -->
    <!-- Only an implicit style: a keyed one declared here would resolve for nothing,  -->
    <!-- because Generic.xaml is loaded for a control's default style and is not       -->
    <!-- merged into Application.Resources.                                            -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:TrendChart">
        <!--
            Not a tab stop, like every other non-interactive control in this file (A11Y-1, A11Y-2,
            #22). Control.IsTabStop defaults to True, so a custom control is in the tab order unless
            it says otherwise, and this was the one that never did: Tab landed on both charts on the
            Timing page and nothing was drawn, because there is no focus visual and nothing to give
            focus to. A stop that neither responds nor indicates is a hole a keyboard user falls
            into - focus vanishes, and the next Tab moves on.

            The alternative, a focus visual, would be decoration on a control with no keyboard model.
            SkyPlotControl is a tab stop because its arrow keys do something; this draws a picture.
            Nothing is lost: the range selector beside it is focusable, the CSV export button is, and
            AutomationProperties.Name still reaches a screen reader, which does not navigate by Tab.
        -->
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TrendChart">
                    <Border Background="{ThemeResource WzLayerFillBrush}"
                            CornerRadius="{ThemeResource WzCardCornerRadius}"
                            Padding="{ThemeResource WzSpaceXsThickness}">
                        <!--
                            No ClipToBounds: that is a WPF property and a XAML compiler error here.
                            The drawing clamps its own coordinates instead, which it has to do
                            anyway - a column whose extreme is off the axis must stop at the edge
                            rather than be hidden by a clip.
                        -->
                        <Canvas x:Name="PART_Surface" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SkyPlotControl (§10.5, §9.10.2, P0-9)                                        -->
    <!--                                                                              -->
    <!-- The plot itself is drawn into PART_Canvas in code: circles, a cross, some     -->
    <!-- text and one Button per satellite. What is here is the frame around it and    -->
    <!-- the marker's own shape, which is a Style rather than a per-marker template    -->
    <!-- so every marker is the same shape by construction.                            -->
    <!-- =========================================================================== -->

    <Style TargetType="controls:SkyPlotControl">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SkyPlotControl">
                    <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                        <!--
                            Square, and sized by the control from its own width capped at
                            MaxPlotSize. A polar plot on a non-square surface is an ellipse, and
                            an ellipse read as a circle is a plot that lies about azimuth.
                        -->
                        <Grid x:Name="PART_Surface">
                            <Canvas x:Name="PART_Canvas" />
                        </Grid>

                        <!--
                            §10.5's legend, minus its third entry. The wireframe offers
                            "✱ trying", but the receiver's Not Tracking table carries no status
                            column, so acquiring and trying are not on the wire - see
                            SkyPlotMarkerKind. Below the mask is derivable and takes its place.
                        -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceMd}"
                                    AutomationProperties.AccessibilityView="Raw">
                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource WzSequential5Brush}"
                                         Stroke="{ThemeResource WzStrokeDefaultBrush}"
                                         StrokeThickness="1" />
                                <TextBlock Text="tracked"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXxs}">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Fill="{ThemeResource WzCardFillBrush}"
                                         Stroke="{ThemeResource WzTextSecondaryBrush}"
                                         StrokeThickness="1.5" />
                                <TextBlock Text="predicted"
                                           Style="{ThemeResource WzCaptionTextStyle}"
                                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            </StackPanel>

