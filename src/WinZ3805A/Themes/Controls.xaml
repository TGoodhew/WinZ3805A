<?xml version="1.0" encoding="utf-8" ?>

<!--
    Shared control styles composed entirely from the tokens in Colors, Typography,
    Spacing, and Motion. Nothing here declares a colour, a size, or a radius of its
    own — if a style needs a value that is not a token, the value is wrong or the token
    is missing, and either way the answer is not a literal in this file.

    Deliberately small. The signature controls — SeverityPill, ReadoutTile,
    StatusMedallion, SkyPlotControl — are their own issues (§9.10) and land in
    Controls/ with their own templates. What lives here is the two styles that every
    one of those will sit inside or beside, both fully specified by §9.2 and §9.7.4.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L2 card (§9.2). Fill, one-pixel hairline, 8 px radius, and no shadow.

        The elevation rule is stated so it is testable: a surface casts a shadow if and
        only if it can be dismissed. A card cannot, so it has none. A reviewer can search
        the XAML for Shadow and check every hit is a dialog, flyout, tip, tooltip, or
        menu.
    -->
    <Style x:Key="WzCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WzCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource WzHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource WzCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource WzSpaceMdThickness}" />
    </Style>

    <!-- Feature card: the same surface at the larger internal padding of §9.6. -->
    <Style x:Key="WzFeatureCardStyle" TargetType="Border" BasedOn="{StaticResource WzCardStyle}">
        <Setter Property="Padding" Value="{StaticResource WzSpaceLgThickness}" />
    </Style>

    <!--
        Destructive commands — every tier C command in §8.3 — per §9.7.4:
        WzCriticalBrush foreground, WzStrokeDefaultBrush border, transparent fill.

        Never AccentButtonStyle. Accent means "the safe thing to do next", and putting a
        destructive action on it inverts the one signal the user reads without thinking.

        §9.7.4 amends §8.3 on the surrounding dialog, and the amendment is 450 lines away
        from the text it replaces (#84): in a tier C ContentDialog the destructive action
        is the PrimaryButton wearing this style, Cancel is the CloseButton and is
        DefaultButton so Enter and initial focus land on the safe option, and Escape
        always cancels. Build the dialog from §9.7.4, not from the end of §8.3.

        The leading warning glyph is part of the style rather than each call site, so it
        cannot be forgotten on the one button where it matters most.
    -->
    <Style x:Key="WzDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource WzCriticalBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource WzHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource WzControlCornerRadius}" />

        <!--
            The glyph the comment above promises, applied once here rather than at each call site.
            ContentDialog sets its primary button's Content to the PrimaryButtonText string, and an
            ordinary page button sets it to a string too, so one template covers both.

            16 px, from §9.9's "inline with body text" row rather than its "buttons" row: this is
            a glyph set inline with the button label, not the button icon, and the 20 px figure
            beside a 14 px label reads as a mismatch. DetailsWindow sizes its glyphs the same way.
        -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource WzSpaceXs}"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
