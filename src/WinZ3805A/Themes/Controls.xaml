<?xml version="1.0" encoding="utf-8" ?>

<!--
    Shared control styles composed entirely from the tokens in Colors, Typography,
    Spacing, and Motion. Nothing here declares a colour, a size, or a radius of its
    own — if a style needs a value that is not a token, the value is wrong or the token
    is missing, and either way the answer is not a literal in this file.

    Deliberately small. The signature controls — SeverityPill, ReadoutTile,
    StatusMedallion, SkyPlotControl — are their own issues (§9.10) and land in
    Controls/ with their own templates. What lives here is the two styles that every
    one of those will sit inside or beside, both fully specified by §9.2 and §9.7.4.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        L2 card (§9.2). Fill, one-pixel hairline, 8 px radius, and no shadow.

        The elevation rule is stated so it is testable: a surface casts a shadow if and
        only if it can be dismissed. A card cannot, so it has none. A reviewer can search
        the XAML for Shadow and check every hit is a dialog, flyout, tip, tooltip, or
        menu.
    -->
    <Style x:Key="WzCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource WzCardFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource WzHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource WzCardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource WzSpaceMdThickness}" />
    </Style>

    <!-- Feature card: the same surface at the larger internal padding of §9.6. -->
    <Style x:Key="WzFeatureCardStyle" TargetType="Border" BasedOn="{StaticResource WzCardStyle}">
        <Setter Property="Padding" Value="{StaticResource WzSpaceLgThickness}" />
    </Style>

    <!--
        Destructive commands — every tier C command in §8.3 — per §9.7.4:
        WzCriticalBrush foreground, WzStrokeDefaultBrush border, transparent fill.

        Never AccentButtonStyle. Accent means "the safe thing to do next", and putting a
        destructive action on it inverts the one signal the user reads without thinking.

        §9.7.4 amends §8.3 on the surrounding dialog, and the amendment is 450 lines away
        from the text it replaces (#84): in a tier C ContentDialog the destructive action
        is the PrimaryButton wearing this style, Cancel is the CloseButton and is
        DefaultButton so Enter and initial focus land on the safe option, and Escape
        always cancels. Build the dialog from §9.7.4, not from the end of §8.3.

        The leading warning glyph is part of the style rather than each call site, so it
        cannot be forgotten on the one button where it matters most.
    -->
    <Style x:Key="WzDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource WzCriticalBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource WzHairlineThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource WzControlCornerRadius}" />

        <!--
            The glyph the comment above promises, applied once here rather than at each call site.
            ContentDialog sets its primary button's Content to the PrimaryButtonText string, and an
            ordinary page button sets it to a string too, so one template covers both.

            16 px, from §9.9's "inline with body text" row rather than its "buttons" row: this is
            a glyph set inline with the button label, not the button icon, and the 20 px figure
            beside a 14 px label reads as a mismatch. DetailsWindow sizes its glyphs the same way.
        -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource WzSpaceXs}"
                                VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BA;"
                                  FontSize="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Keyed styles live here rather than in Generic.xaml. Generic.xaml is loaded for a control's
        implicit default style and is not merged into Application.Resources, so a keyed entry in it
        resolves for nothing - not from a page, and not from Application.Current.Resources either.
        A page referencing one silently fails to load, which is exactly as informative as it sounds.
    -->

    <!-- =========================================================================== -->
    <!-- Dense list rows (§9.6.3)                                                     -->
    <!--                                                                              -->
    <!-- §10.5's tables need a real selection model - the sky plot selects into them   -->
    <!-- and A11Y-11 wants them navigable on their own - but a stock ListViewItem is   -->
    <!-- 40 px tall with 12 px of side padding, which turns a six-row satellite table  -->
    <!-- into a scrolling one. §9.6.3 commits to a single density, so the container is -->
    <!-- trimmed to the row's own padding rather than the density being changed.       -->
    <!--                                                                              -->
    <!-- MinHeight is 32, not 0. Trimming the padding is right; removing the floor was -->
    <!-- not. With 0 these rows rendered 26-28 px - measured live at 632x26 on the     -->
    <!-- Satellites page - under A11Y-5's 32 px pointer floor, on a row that is a      -->
    <!-- selection target. It is a FLOOR and not a fixed height, so rows still grow    -->
    <!-- with scaled text, which is what the 0 was protecting.                         -->
    <!--                                                                              -->
    <!-- This one is load-bearing beyond its own criterion: §9.10.2 grants the sky     -->
    <!-- plot's 24 px markers the app's only recorded A11Y-5 exception on the grounds  -->
    <!-- that the table rows are an alternate route and are "past 40 px". At 26 px     -->
    <!-- they were not, so both the primary and the alternate target were under the    -->
    <!-- floor and the exception rested on a false premise.                            -->
    <!-- =========================================================================== -->

    <Style x:Key="WzDenseListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="{ThemeResource WzSpaceXxsThickness}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="WzSkyPlotMarkerStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        A circle, because that is what a satellite marker is. The fill and the
                        stroke come from the control, which is where the ramp step and the
                        tracked/predicted distinction are decided.

                        The transparent Grid is the hit area and is deliberately larger than the
                        disc: a 9 px marker is an unreasonable pointer target (A11Y-5), and the
                        control insets the visible circle inside a bigger button through Padding.
                    -->
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Marker"
                                 Margin="{TemplateBinding Padding}"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="{TemplateBinding BorderThickness}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Marker.Stroke" Value="{ThemeResource WzAccentFillBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Marker.Stroke" Value="{ThemeResource WzAccentFillBrush}" />
                                            <Setter Target="Marker.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
