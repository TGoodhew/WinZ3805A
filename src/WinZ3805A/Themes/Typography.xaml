<?xml version="1.0" encoding="utf-8" ?>

<!--
    §9.5 — the seven-step type ramp, the four readout styles, and the faces they use.

    The type personality comes from the Segoe / Cascadia split and from the readout
    scale, not from a third family (§9.5.1). The split is load-bearing rather than
    decorative: it makes "what the machine said" visually distinct from "what the app
    says about it", in an application whose whole job is faithful reporting.

    Where a stock WinUI style exists the ramp is BasedOn it with only the documented
    deltas applied, so the app inherits future Fluent refinement instead of freezing a
    snapshot of it.

    Theme-invariant, so no theme dictionaries. Type that changed size with the theme
    would reflow the whole app on a theme switch.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- §9.5.1 Faces                                                  -->
    <!-- ============================================================ -->

    <!--
        Optical size is why there are two Segoe entries rather than one. Variable Text
        is drawn for small sizes and Variable Display for large; §9.5.1 forbids Display
        below 18 px, where its tighter fitting makes body text harder to read.
    -->
    <FontFamily x:Key="WzTextFontFamily">Segoe UI Variable Text, Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="WzDisplayFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI</FontFamily>

    <!--
        §9.5.1 requires the mono face to be embedded in the package and referenced by
        ms-appx URI rather than assumed present: Cascadia is inbox on Windows 11 but
        cannot be relied on for Windows 10. The URI is written in that form here so that
        landing the font is dropping a file into Assets/Fonts and nothing else.

        The font is embedded: Assets/Fonts/CascadiaMono.ttf, the variable face from
        microsoft/cascadia-code v2407.24, 714,804 bytes, whose family name really is
        "Cascadia Mono" so the fragment above resolves. SIL OFL 1.1 permits the
        redistribution and the licence ships beside it (OQ-D2, #43).

        Consolas remains in the chain and is present on every supported version, so a
        packaging mistake degrades rather than showing squares.
    -->
    <FontFamily x:Key="WzMonoFontFamily">ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============================================================ -->
    <!-- §9.5.2 Ramp                                                   -->
    <!--                                                               -->
    <!-- Tracking is expressed in CharacterSpacing, which WinUI counts  -->
    <!-- in thousandths of an em: -0.01 em is -10.                      -->
    <!-- ============================================================ -->

    <Style x:Key="WzCaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzTextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="WzBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzTextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="WzBodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzTextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WzSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="WzTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
    </Style>

    <Style x:Key="WzTitleLargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="52" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-15" />
    </Style>

    <!-- Reserved by §9.5.2 and not used in v1. Present so the ramp is complete. -->
    <Style x:Key="WzDisplayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DisplayTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="LineHeight" Value="80" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-20" />
    </Style>

    <!-- ============================================================ -->
    <!-- §9.5.3 Numeric treatment                                      -->
    <!--                                                               -->
    <!-- Tabular figures on every readout, because a value stepping    -->
    <!-- from -33.1 to -9.8 in proportional figures shifts sideways    -->
    <!-- and, glanced at across a bench, reads as motion where there   -->
    <!-- is none. This is the single most load-bearing setting in the  -->
    <!-- file. OQ-D1 (#42) confirmed the attached property resolves in -->
    <!-- WinAppSDK 2.3.1.                                              -->
    <!-- ============================================================ -->

    <Style x:Key="WzReadoutLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="WzReadoutMediumTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <Style x:Key="WzReadoutSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WzDisplayFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

    <!--
        Device-literal text: SCPI mnemonics, the transcript, raw register values, log
        lines, the identity string, and coordinates. Selectable, unlike the readouts —
        the whole point of reproducing what the device said is that it can be copied
        into a bug report. Exempt from the U+2212 rule in §9.5.3 item 4, because this
        text is reproduced verbatim.
    -->
    <Style x:Key="WzMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource WzMonoFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <!--
            SELECTION IS OPT-IN, AND THIS DEFAULT USED TO BE True (#405).

            A TextBlock with text selection enabled captures pointer input so it can drag out a
            selection, so it SWALLOWS a click meant for whatever is underneath. In the Advanced
            Console's command picker that made the mnemonic column dead: clicking the ":SYST:COMM"
            of a command did nothing at all - the press never reached the ComboBoxItem and the
            dropdown did not even close - while clicking the description beside it selected
            normally. A user cannot be expected to learn which half of a row is clickable.

            Every place that genuinely wants selection already asks for it in the markup - the
            console transcript and its command preview, the diagnostics cards, the readouts a user
            copies figures out of. There were sixteen such explicit opt-ins and they are unaffected;
            what this removes is selection nobody asked for, on text sitting inside something
            clickable.
        -->
        <Setter Property="IsTextSelectionEnabled" Value="False" />
    </Style>

</ResourceDictionary>
