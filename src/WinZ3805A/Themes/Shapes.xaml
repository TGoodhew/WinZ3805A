<?xml version="1.0" encoding="utf-8" ?>

<!--
    §9.4.3's severity shapes, as path geometry.

    These are tokens rather than part of any one control's template, and they moved here from
    Themes/Generic.xaml when a second consumer appeared (#32). Generic.xaml is the control-library
    default-styles dictionary: WinUI loads it for custom control templates, but it is NOT merged
    into Application.Resources, so a page referencing a key defined only there resolves nothing at
    run time. A control template still finds these, because ThemeResource lookup walks up to the
    application.

    Each path is drawn in a 12x12 box so the five are optically consistent, and the distinctions
    are deliberately coarse - filled circle, triangle, hexagon, circled i, hollow ring - because
    they have to survive being small, being greyscale, and being seen from across a room. That is
    also what makes them the second channel A11Y-12 requires: colour convergence under protanopia
    or deuteranopia does not touch a shape, and neither does high contrast collapsing every
    severity brush onto SystemColorWindowTextColor.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="WzShapeCircle">M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z</x:String>
    <x:String x:Key="WzShapeTriangle">M 6,0 L 12,11 L 0,11 Z</x:String>
    <x:String x:Key="WzShapeHexagon">M 6,0 L 11.2,3 L 11.2,9 L 6,12 L 0.8,9 L 0.8,3 Z</x:String>
    <!-- F0 is the even-odd fill rule, which is what knocks the glyph out of the disc. -->
    <x:String x:Key="WzShapeInfo">F0 M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z M 5.1,5.1 L 6.9,5.1 L 6.9,9.4 L 5.1,9.4 Z M 5.1,2.4 L 6.9,2.4 L 6.9,4.1 L 5.1,4.1 Z</x:String>
    <x:String x:Key="WzShapeRing">F0 M 0,6 A 6,6 0 1 0 12,6 A 6,6 0 1 0 0,6 Z M 2.4,6 A 3.6,3.6 0 1 0 9.6,6 A 3.6,3.6 0 1 0 2.4,6 Z</x:String>

</ResourceDictionary>
