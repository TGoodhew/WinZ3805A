<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>ARM64</Platform>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>

    <!--
      §6.3: framework-dependent, NOT self-contained. The Store resolves the
      Windows App SDK framework package dependency and this keeps the
      submission small. The template shipped SelfContained=true; both flags
      are pinned false here deliberately.
    -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <PublishSingleFile>False</PublishSingleFile>

    <!--
      ReadyToRun is a publish-time optimisation. It lives here rather than in
      the csproj so an ordinary Release *build* does not require the crossgen
      runtime pack to have been restored (NETSDK1094).
      §6.4 forbids trimming and Native AOT; neither is enabled anywhere.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
