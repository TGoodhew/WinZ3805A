<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>

    <!--
      §6.3: self-contained for .NET, framework-dependent for the Windows App
      SDK - the same two flags the csproj sets, and for the reasons given
      there (#586). Restated here because a publish reads this profile, and a
      profile that disagreed with the csproj would be a second answer.
    -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>

    <PublishSingleFile>False</PublishSingleFile>

    <!--
      ReadyToRun is a publish-time optimisation. It lives here rather than in
      the csproj so an ordinary Release *build* does not require the crossgen
      runtime pack to have been restored (NETSDK1094).
      §6.4 forbids trimming and Native AOT; neither is enabled anywhere.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
