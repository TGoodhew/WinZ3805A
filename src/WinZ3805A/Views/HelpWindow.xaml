<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinZ3805A.Views.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The user's guide, F1 from either window (#312). Title and TitleBar.Title are set in code
        from Package.appxmanifest (§6.3). The document is built in code from the block model
        HelpDocument produces; everything it is built FROM - every brush, size and margin - is
        declared here, so the renderer never captures a brush and the window re-themes on its
        own (§9.13 item 2).

        No <Window.SystemBackdrop>, for MainWindow's reason: the solid fallback is the default and
        Services/WindowBackdrop upgrades it to Mica Alt where the platform has it (#191).
    -->

    <Grid Background="{ThemeResource WzPageBackgroundFallbackBrush}">
        <Grid.Resources>
            <!-- Body text. A RichTextBlock cannot be BasedOn a TextBlock style, so this mirrors WzBodyTextStyle. -->
            <Style x:Key="HelpBodyStyle" TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{StaticResource WzTextFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>

            <Style x:Key="HelpHeading1Style" TargetType="TextBlock" BasedOn="{StaticResource WzTitleLargeTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
            </Style>
            <Style x:Key="HelpHeading2Style" TargetType="TextBlock" BasedOn="{StaticResource WzTitleTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
            <Style x:Key="HelpHeading3Style" TargetType="TextBlock" BasedOn="{StaticResource WzSubtitleTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,16,0,0" />
            </Style>
            <Style x:Key="HelpHeading4Style" TargetType="TextBlock" BasedOn="{StaticResource WzBodyStrongTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>

            <!-- Device-literal text - the scalar queries, the uninstall command - in Cascadia (§9.5.1). -->
            <Style x:Key="HelpCodeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WzMonoTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextPrimaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="HelpCodeBlockStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WzCardFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource WzControlCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource WzSpaceSmThickness}" />
            </Style>

            <Style x:Key="HelpQuoteStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="4,0,0,0" />
                <Setter Property="Padding" Value="16,4,0,4" />
            </Style>

            <Style x:Key="HelpRuleStyle" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="{ThemeResource WzStrokeSubtleBrush}" />
                <Setter Property="Margin" Value="0,8,0,8" />
            </Style>

            <!-- Tables: one outer border with the control radius, hairline cell borders inside it. -->
            <Style x:Key="HelpTableStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1,1,0,0" />
                <Setter Property="CornerRadius" Value="{StaticResource WzControlCornerRadius}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="HelpCellStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource WzStrokeSubtleBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="{StaticResource WzSpaceXsThickness}" />
            </Style>
            <Style x:Key="HelpHeaderCellStyle" TargetType="Border" BasedOn="{StaticResource HelpCellStyle}">
                <Setter Property="Background" Value="{ThemeResource WzCardFillBrush}" />
            </Style>

            <Style x:Key="HelpFooterStyle" TargetType="TextBlock" BasedOn="{StaticResource WzCaptionTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource WzTextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,24,0,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Height="48">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!--
                A measure, not a whim: 760 px of 14 px text is around ninety characters a line,
                past which a paragraph gets hard to track back across. Left-aligned so the text
                stays put when the window is widened for the images.
            -->
            <StackPanel x:Name="Body"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Margin="{StaticResource WzSpaceXlThickness}"
                        Spacing="{StaticResource WzSpaceSm}" />
        </ScrollViewer>
    </Grid>
</Window>
