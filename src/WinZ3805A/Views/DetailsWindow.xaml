<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinZ3805A.Views.DetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Title and TitleBar.Title are set in code from Package.appxmanifest (§6.3). Do not
        hard-code a product name here.
    -->

    <!--
        No <Window.SystemBackdrop> here on purpose. §9.2 requires Mica Alt where the platform has
        it and WzPageBackgroundFallbackBrush where it does not, and says "never let an unsupported
        backdrop produce a transparent or black window". So the SOLID is the default declared in
        markup and Services/WindowBackdrop upgrades it to Mica Alt at construction. Declaring Mica
        here and stripping it when unsupported would make the black window the thing that happens
        when a code path does not run (#191).

        Background is a ThemeResource, so the fallback follows a theme change on its own. Do not
        replace it with a brush captured from Application.Current.Resources.
    -->

    <Grid Background="{ThemeResource WzPageBackgroundFallbackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            §9.7.3: 48 px, icon and name at the left, the connection pill centred, and Refresh /
            Export / Settings at the right. Nothing else is permitted in the bar.

            Caption-button clearance is not set here and must never be: the TitleBar control reads
            AppWindowTitleBar.RightInset/LeftInset itself, which is what makes it correct in RTL and
            at non-100% scaling. A hard-coded 138 px is the failure §9.7.3 calls out by name.
        -->
        <TitleBar x:Name="AppTitleBar" Height="48">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <controls:ConnectionStatusPill x:Name="StatusPill"
                                               Click="OnStatusPillClicked" />
            </TitleBar.Content>

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal"
                            Spacing="{ThemeResource WzSpaceXxs}"
                            VerticalAlignment="Center">
                    <!--
                        §9.9: an icon may appear without a visible label only in the title bar or a
                        card header, and only with both a tooltip carrying the label and accelerator
                        and an automation name. All three, no exceptions - and CI checks it.
                    -->
                    <Button x:Name="RefreshButton"
                            MinWidth="32"
                            MinHeight="32"
                            Click="OnRefreshClicked"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Refresh full status"
                            ToolTipService.ToolTip="Refresh full status (F5)">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExportButton"
                            MinWidth="32"
                            MinHeight="32"
                            Click="OnExportClicked"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Export current view"
                            ToolTipService.ToolTip="Export current view (Ctrl+E)">
                        <FontIcon Glyph="&#xEDE1;" FontSize="16" />
                    </Button>
                    <Button x:Name="SettingsButton"
                            MinWidth="32"
                            MinHeight="32"
                            Click="OnSettingsClicked"
                            Background="Transparent"
                            BorderThickness="0"
                            AutomationProperties.Name="Settings"
                            ToolTipService.ToolTip="Settings (Ctrl+,)">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            §9.11's connection banner, pinned below the title bar (#252). Its own row rather than an
            overlay, so it pushes the content down instead of covering the top of a page — the pages
            below carry readings, and hiding one behind a bar is the §9.11 failure of blanking data
            rather than marking it.

            Not closable: this reports a state rather than an event, so there is nothing for closing
            it to mean. It disappears when the state does.

            What it says is ConnectionBanner's decision, not this file's. §9.11 gives this slot two
            different rows - informational for a disconnect the user asked for, error with a retry
            countdown and two actions for a link that dropped (#248) - and choosing between them in
            markup would make a defect look like a styling choice.
        -->
        <InfoBar x:Name="ConnectionBar"
                 Grid.Row="1"
                 IsOpen="False"
                 IsClosable="False"
                 Margin="{ThemeResource WzSpaceSmThickness}" />

        <!--
            §9.6.1's breakpoints are configured, never hand-rolled: the control already implements
            Auto mode against these two thresholds, and reimplementing it would forfeit the free
            behaviour along with its accessibility.
        -->
        <NavigationView x:Name="Nav"
                        Grid.Row="2"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="{ThemeResource WzCompactModeThresholdWidth}"
                        ExpandedModeThresholdWidth="{ThemeResource WzExpandedModeThresholdWidth}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="260"
                        SelectionChanged="OnNavigationSelectionChanged"
                        PaneOpened="OnPaneStateChanged"
                        PaneClosed="OnPaneStateChanged">
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
