<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.StatusRegistersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinZ3805A.ViewModels"
    mc:Ignorable="d">

    <!--
        §10.10. Read on demand, never on a cadence: reading the EVENt field clears the latches, so
        a poll would consume the very events a user opened this page to look at.

        The bit meanings come from the 58503A guide (#34, OQ-1). §10.10's "(see documentation)"
        fallback is still here for the bits the guide marks unused and for anything a firmware
        revision sets beyond the table, but it is now the exception.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceMd}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{ThemeResource WzTitleTextStyle}" Text="Status registers" />

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClicked"
                        VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Read this register from the receiver" />
            </Grid>

            <ComboBox x:Name="RegisterPicker"
                      MinWidth="240"
                      HorizontalAlignment="Left"
                      Header="Register"
                      DisplayMemberPath="Name"
                      SelectionChanged="OnRegisterChanged" />

            <TextBlock x:Name="SummaryText"
                       Style="{ThemeResource WzBodyTextStyle}"
                       Foreground="{ThemeResource WzTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="{ThemeResource WzProseMaxWidth}" />

            <ProgressRing x:Name="ReadingRing"
                          IsActive="False"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Reading the register" />

            <InfoBar x:Name="ErrorBar"
                     IsOpen="False"
                     IsClosable="False"
                     Severity="Error"
                     Title="Could not read the register" />

            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                    <Grid ColumnSpacing="{ThemeResource WzSpaceSm}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Bit" />
                        <TextBlock Grid.Column="1" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Cond" />
                        <TextBlock Grid.Column="2" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Event" />
                        <TextBlock Grid.Column="3" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Enab" />
                        <TextBlock Grid.Column="4" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="PTr" />
                        <TextBlock Grid.Column="5" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="NTr" />
                        <TextBlock Grid.Column="6" Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Meaning" />
                    </Grid>

                    <ItemsControl x:Name="BitRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RegisterBitRow">
                                <Grid ColumnSpacing="{ThemeResource WzSpaceSm}" Padding="0,4"
                                      AutomationProperties.Name="{x:Bind Description}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind Bit}" />
                                    <TextBlock Grid.Column="1" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind ConditionText}" />
                                    <TextBlock Grid.Column="2" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind EventText}" />
                                    <TextBlock Grid.Column="3" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind EnableText}" />
                                    <TextBlock Grid.Column="4" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind PositiveTransitionText}" />
                                    <TextBlock Grid.Column="5" Style="{ThemeResource WzMonoTextStyle}"
                                               Text="{x:Bind NegativeTransitionText}" />
                                    <TextBlock Grid.Column="6" Style="{ThemeResource WzBodyTextStyle}"
                                               TextWrapping="Wrap"
                                               Text="{x:Bind MeaningText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="RawText"
                               Style="{ThemeResource WzMonoTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Read on demand"
                     Message="Reading the event field clears its latches, so this page reads only when you ask it to. Changing the enable and transition masks is a write, and arrives with the confirmation dialogs in §15 step 10." />
        </StackPanel>
    </ScrollViewer>
</Page>
