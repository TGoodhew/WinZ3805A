<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.StatusRegistersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinZ3805A.ViewModels"
    xmlns:controls="using:WinZ3805A.Controls"
    mc:Ignorable="d">

    <!--
        §10.10. Read on demand, never on a cadence: reading the EVENt field clears the latches, so
        a poll would consume the very events a user opened this page to look at.

        The bit meanings come from the 58503A guide (#34, OQ-1). §10.10's "(see documentation)"
        fallback is still here for the bits the guide marks unused and for anything a firmware
        revision sets beyond the table, but it is now the exception.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageRoot"
                    Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Spacing="{ThemeResource WzSpaceMd}">
                <VisualStateManager.VisualStateGroups>
                    <!--
                        §9.6.1's page margin: WzSpaceXl (24) at Medium and Wide, WzSpaceMd (16) at
                        Compact. WzPageMarginCompactThickness had existed in Spacing.xaml with no
                        consumer since the token layer was written (#316); this is that consumer.

                        AN ADAPTIVE TRIGGER AND NOT CODE. §9.6.1's instruction not to hand-roll
                        breakpoint logic is aimed at NavigationView, which implements its own — but
                        the reasoning carries: a margin decided in a SizeChanged handler is a
                        breakpoint that no longer appears in the markup it governs, and the next
                        person to read this page would have no way to know one existed.

                        The Compact state's threshold is WzExpandedModeThresholdWidth (1024), the
                        same number NavigationView is configured with, so the rail and the margin
                        change together rather than a few pixels apart.

                        NOT REACHABLE ON EVERY MACHINE. §9.6.2 sets the Details minimum at 1024 as a
                        CONTENT size clamped to the display work area, so on a wide monitor at 100%
                        scaling this state cannot be entered by dragging the window - it is for high
                        display scaling, where the same 1024 of content is fewer effective pixels.
                        Which is exactly why it is declarative: a state that cannot be exercised on
                        the hardware to hand must at least be readable.
                    -->
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{ThemeResource WzExpandedModeThresholdWidth}" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="CompactLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="PageRoot.Padding" Value="{ThemeResource WzPageMarginCompactThickness}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{ThemeResource WzTitleTextStyle}" Text="Status registers" />

                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClicked"
                        VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Read this register from the receiver" />
            </Grid>

            <!--
                §9.6.1's content grid (#345). The cards flow into as many columns as the width
                holds, each going to whichever column is currently SHORTEST - so a tall card sits
                alone while two short ones stack beside it, rather than alternating into a ragged
                pair. Every page was a single StackPanel before this, which meant §9.6.1's Compact
                arrangement at every width and half of a wide window empty.

                The page heading stays outside it: a title is not a card, and it belongs across the
                top rather than in whichever column happened to be shorter.
            -->
            <controls:CardColumns controls:CardEntrance.IsEnabled="True"
                                  ColumnSpacing="{ThemeResource WzSpaceXl}"
                                  RowSpacing="{ThemeResource WzSpaceXl}">
                <ComboBox x:Name="RegisterPicker"
                          MinWidth="240"
                          HorizontalAlignment="Left"
                          Header="Register"
                          DisplayMemberPath="Name"
                          SelectionChanged="OnRegisterChanged" />

                <TextBlock x:Name="SummaryText"
                           Style="{ThemeResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           MaxWidth="{ThemeResource WzProseMaxWidth}" />

                <ProgressRing x:Name="ReadingRing"
                              IsActive="False"
                              Width="20"
                              Height="20"
                              HorizontalAlignment="Left"
                              AutomationProperties.Name="Reading the register" />

                <InfoBar x:Name="ErrorBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Error"
                         Title="Could not read the register" />

                <Border Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                        <Grid ColumnSpacing="{ThemeResource WzSpaceSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Bit" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Cond" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Event" />
                            <TextBlock Grid.Column="3" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Enab" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="PTr" />
                            <TextBlock Grid.Column="5" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="NTr" />
                            <TextBlock Grid.Column="6" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Meaning" />
                        </Grid>

                        <ItemsControl x:Name="BitRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RegisterBitRow">
                                    <Grid ColumnSpacing="{ThemeResource WzSpaceSm}" Padding="0,4"
                                          AutomationProperties.Name="{x:Bind Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind Bit}" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind ConditionText}" />
                                        <TextBlock Grid.Column="2" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind EventText}" />
                                        <!--
                                            The three masks are settings, not readings, so §10.10 draws
                                            them as boxes and P1-4 makes them editable. TwoWay, and the
                                            rows are cached in the view model - handing out fresh row
                                            objects on each render would discard a half-finished edit
                                            every time the staleness ticker fires.

                                            Each carries its own automation name because a bare checkbox
                                            in a grid announces only "checkbox"; the row's own name says
                                            which bit, but not which of three columns has focus.

                                            MinWidth is 32, not 0. WinUI's default CheckBoxMinWidth is
                                            120, which would force these 48 px columns open - that is
                                            what the 0 here was for. But 0 let the box render 28 px wide,
                                            under A11Y-5's 32 px pointer floor, measured on all 21 of
                                            them. 32 satisfies the floor and still fits the column.

                                            MinHeight is stated for the same reason rather than left to
                                            the framework's default. These carry a tooltip, so they are
                                            pointer targets, and Test-PointerTargets.ps1 requires the
                                            floor to be DECLARED - a floor that holds only while a stock
                                            style happens to supply it is not a floor, it is a
                                            coincidence that survives until someone restyles the control.
                                        -->
                                        <CheckBox Grid.Column="3"
                                                  MinWidth="32"
                                                  MinHeight="32"
                                                  IsChecked="{x:Bind EnableBit, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind CanEditEnable}"
                                                  AutomationProperties.Name="{x:Bind EnableName}"
                                                  ToolTipService.ToolTip="Enable mask" />
                                        <CheckBox Grid.Column="4"
                                                  MinWidth="32"
                                                  MinHeight="32"
                                                  IsChecked="{x:Bind PositiveBit, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind CanEditPositive}"
                                                  AutomationProperties.Name="{x:Bind PositiveName}"
                                                  ToolTipService.ToolTip="Positive-transition mask" />
                                        <CheckBox Grid.Column="5"
                                                  MinWidth="32"
                                                  MinHeight="32"
                                                  IsChecked="{x:Bind NegativeBit, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind CanEditNegative}"
                                                  AutomationProperties.Name="{x:Bind NegativeName}"
                                                  ToolTipService.ToolTip="Negative-transition mask" />
                                        <TextBlock Grid.Column="6" Style="{ThemeResource WzBodyTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="{x:Bind MeaningText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="RawText"
                                   controls:CopyMenu.IsCopyable="True"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap" />

                        <controls:CommandOutcomeBar x:Name="MaskOutcome" />

                        <!-- §10.10's single "Apply mask changes", with Discard beside it: an edit that
                             cannot be undone without re-reading the register would make the checkboxes
                             feel like switches on the instrument rather than a pending change. -->
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{ThemeResource WzSpaceXs}"
                                    HorizontalAlignment="Right">
                            <Button x:Name="DiscardMasksButton"
                                    Content="Discard changes"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Put the mask checkboxes back to what the receiver reported"
                                    Click="OnDiscardMasksClicked" />
                            <Button x:Name="ApplyMasksButton"
                                    Content="Apply mask changes"
                                    Style="{ThemeResource WzDestructiveButtonStyle}"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Write the changed masks to the receiver"
                                    Click="OnApplyMasksClicked" />
                        </StackPanel>

                        <!-- §9.11: absent is disabled and explained, never hidden (#304). -->
                        <TextBlock x:Name="MasksUnsupportedText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   HorizontalAlignment="Left"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="PendingText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Left"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}" />
                    </StackPanel>
                </Border>

                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="Read on demand"
                         Message="Reading the event field clears its latches, so this page reads only when you ask it to. Each mask you change is written as a separate command and asks for its own confirmation." />
            </controls:CardColumns>
        </StackPanel>
    </ScrollViewer>
</Page>
