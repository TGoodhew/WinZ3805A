<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.TimingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        §10.7. The calculator computes; it does not apply. :GPS:REF:ADEL can put a locked receiver
        into holdover, so Apply goes through the §8.3 confirmation like every other tier C write.
        The calculator is the part a user cannot do in their head, and P0-11 is the arithmetic.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Timing &amp; antenna" />

            <!-- ========================== Antenna cable delay ========================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceMd}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Antenna cable delay" />

                    <Grid ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="In use now" />
                        <TextBlock x:Name="CurrentDelayText" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />
                    </Grid>

                    <!--
                        §10.7's two ways in. Direct entry first, as the wireframe draws it: a user
                        who already knows their delay should not have to work through a calculator
                        to type it, and the surplus-equipment buyer (§3) usually does not know it
                        and needs the calculator. Both feed the same Apply.
                    -->
                    <RadioButton x:Name="EnterDirectlyRadio"
                                 Content="Enter delay directly"
                                 GroupName="DelaySource"
                                 Checked="OnDelaySourceChanged" />

                    <StackPanel Margin="32,0,0,0" Spacing="{ThemeResource WzSpaceXxs}">
                        <NumberBox x:Name="DirectDelayBox"
                                   MinWidth="240"
                                   HorizontalAlignment="Left"
                                   Header="Delay (nanoseconds)"
                                   SmallChange="1"
                                   LargeChange="100"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnDirectDelayChanged" />
                        <controls:FieldErrorText x:Name="DirectDelayError" />
                    </StackPanel>

                    <RadioButton x:Name="CalculateRadio"
                                 Content="Calculate from cable"
                                 GroupName="DelaySource"
                                 IsChecked="True"
                                 Checked="OnDelaySourceChanged" />

                    <StackPanel Margin="32,0,0,0"
                                Spacing="{ThemeResource WzSpaceMd}">

                    <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                        <RadioButton x:Name="UsePresetRadio"
                                     Content="Named cable"
                                     GroupName="CableSource"
                                     IsChecked="True"
                                     Checked="OnCableSourceChanged" />

                        <ComboBox x:Name="CablePicker"
                                  MinWidth="240"
                                  Margin="32,0,0,0"
                                  Header="Cable type"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="OnCableChanged" />

                        <RadioButton x:Name="UseVelocityRadio"
                                     Content="Custom velocity factor"
                                     GroupName="CableSource"
                                     Checked="OnCableSourceChanged" />

                        <NumberBox x:Name="VelocityFactorBox"
                                   MinWidth="240"
                                   Margin="32,0,0,0"
                                   Header="Velocity factor"
                                   Minimum="0.01"
                                   Maximum="0.99"
                                   SmallChange="0.01"
                                   IsEnabled="False"
                                   SpinButtonPlacementMode="Compact"
                                   ValidationMode="InvalidInputOverwritten"
                                   ValueChanged="OnVelocityFactorChanged" />
                    </StackPanel>

                    <StackPanel Spacing="{ThemeResource WzSpaceXxs}">
                        <NumberBox x:Name="LengthBox"
                                   MinWidth="240"
                                   HorizontalAlignment="Left"
                                   Header="Cable length (metres)"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Compact"
                                   ValueChanged="OnLengthChanged" />
                        <controls:FieldErrorText x:Name="LengthError" />
                    </StackPanel>

                    <StackPanel Spacing="{ThemeResource WzSpaceXxs}">
                        <controls:ReadoutTile x:Name="ComputedDelay"
                                              Label="Computed delay"
                                              Unit="ns"
                                              DecimalPlaces="1"
                                              MaxIntegerDigits="6"
                                              Size="Medium" />
                        <TextBlock x:Name="CableSourceText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextTertiaryBrush}" />
                        <controls:FieldErrorText x:Name="ComputedDelayError" />
                    </StackPanel>

                    <controls:SeverityPill x:Name="DifferencePill" Visibility="Collapsed" />
                    </StackPanel>

                    <!--
                        §10.7's warning, which is the reason the command is tier C in the first
                        place. It stays visible rather than appearing on hover: the consequence is
                        the same every time, so hiding it until the user is already committing is
                        the wrong moment to mention it.
                    -->
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="Before applying"
                             Message="Changing the antenna delay while the receiver is locked can send it into holdover." />

                    <controls:CommandOutcomeBar x:Name="DelayOutcome" />

                    <!--
                        §9.7.4 puts Apply inline with the values it affects, never in a page-level
                        bar. §9.11 keeps it disabled while any field in this card is invalid.
                    -->
                    <Button x:Name="ApplyDelayButton"
                            HorizontalAlignment="Right"
                            Content="Apply delay"
                            Style="{ThemeResource WzDestructiveButtonStyle}"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Send this delay to the receiver"
                            Click="OnApplyDelayClicked" />
                </StackPanel>
            </Border>

            <!-- =========================== 1 PPS time interval ========================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="1 PPS time interval" />

                    <Grid ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:ReadoutTile x:Name="TimeInterval"
                                              Grid.Column="0"
                                              Label="Current"
                                              Unit="ns"
                                              DecimalPlaces="1"
                                              MaxIntegerDigits="5"
                                              AllowNegative="True"
                                              Size="Medium" />

                        <controls:ReadoutTile x:Name="Deviation"
                                              Grid.Column="1"
                                              Label="σ"
                                              Unit="ns"
                                              DecimalPlaces="1"
                                              MaxIntegerDigits="5"
                                              Size="Medium" />
                    </Grid>

                    <TextBlock x:Name="DeviationWindowText"
                               Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Style="{ThemeResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
