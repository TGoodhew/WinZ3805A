<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinZ3805A.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinZ3805A.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Title and TitleBar.Title are deliberately NOT set here. §6.3 requires the
        display name to be read from Package.appxmanifest at runtime, because
        package identity is permanent while display name is a one-line change.
        Both are assigned in the constructor. Do not hard-code a product name in
        this file.
    -->

    <!--
        No <Window.SystemBackdrop> here on purpose. §9.2 requires Mica Alt where the platform has
        it and WzPageBackgroundFallbackBrush where it does not, and says "never let an unsupported
        backdrop produce a transparent or black window". So the SOLID is the default declared in
        markup and Services/WindowBackdrop upgrades it to Mica Alt at construction. Declaring Mica
        here and stripping it when unsupported would make the black window the thing that happens
        when a code path does not run (#191).

        Background is a ThemeResource, so the fallback follows a theme change on its own. Do not
        replace it with a brush captured from Application.Current.Resources.
    -->

    <Grid Background="{ThemeResource WzPageBackgroundFallbackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar">
            <!--
                #568. Two of the control's own theme resources, overridden for this title bar only.

                Giving a TitleBar any header content moves it to its ExpandedHeight state, which is
                TitleBarExpandedHeight - 48 px. The pushpin below made this bar 16 px thicker, and
                compact mode's 144 px (§9.6.2: a 32 px title bar over a 112 px page) lost those 16 from
                the page, clipping the bottom of the medallion. Aliasing the expanded height to the
                compact one keeps the bar the 32 px the wireframes are built from.

                The right header is followed by a column of TitleBarMinDragRegionWidth, a strip of
                guaranteed drag area beside the caption buttons - which stood the pushpin 48 px short
                of them, in the middle of the bar. WzSpaceXs instead puts it against them, and the rest
                of the bar still drags.
            -->
            <TitleBar.Resources>
                <StaticResource x:Key="TitleBarExpandedHeight" ResourceKey="TitleBarCompactHeight" />
                <StaticResource x:Key="TitleBarMinDragRegionWidth" ResourceKey="WzSpaceXs" />
            </TitleBar.Resources>

            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>

            <!--
                #568. Says the window is pinned, in both layouts. A pinned window and an unpinned
                one otherwise look identical, and in compact mode - where the footer's pin, the
                only other place the state showed, is collapsed - there was nothing at all to
                tell them apart.

                In the RIGHT HEADER, not laid over the bar, because the control makes its header
                content reachable by the pointer. Anything else in this band is the window's drag
                region, where the pointer goes to the frame and a tooltip never opens.

                An indicator and not a button: every route that changes the state is a deliberate
                act elsewhere (the footer, Ctrl+Shift+T, the right-click menu, the notification
                area), and a click target at the end of the band a user drags the window by would
                be a way to unpin it by accident. The tooltip names the key, as §9.7.5's amendment
                requires of every tooltip here.

                A11Y-5: the tooltip makes it a pointer target, so the Border carries the 32 px floor
                with a Transparent background - unset would be null and not hit-testable, and the
                glyph alone would be about 12 px square. 32 is also exactly the bar's height.
            -->
            <TitleBar.RightHeader>
                <Border x:Name="PinnedIndicator"
                        Background="Transparent"
                        MinWidth="32"
                        MinHeight="32"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Kept above other windows"
                        ToolTipService.ToolTip="Kept above other windows. Ctrl+Shift+T, or right-click the window, to change it">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource WzTextSecondaryBrush}"
                              Glyph="&#xE840;" />
                </Border>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--
            Hosts the application's pages. Scaffolding only: the §10.3 main window
            is a small medallion surface and the §9.7 NavigationView shell belongs
            to the separate Receiver Details window.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
