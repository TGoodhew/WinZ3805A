<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WinZ3805A.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinZ3805A.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Title and TitleBar.Title are deliberately NOT set here. §6.3 requires the
        display name to be read from Package.appxmanifest at runtime, because
        package identity is permanent while display name is a one-line change.
        Both are assigned in the constructor. Do not hard-code a product name in
        this file.
    -->

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            Hosts the application's pages. Scaffolding only: the §10.3 main window
            is a small medallion surface and the §9.7 NavigationView shell belongs
            to the separate Receiver Details window.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
