<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Settings, per §10.13.

        The section did not exist when this page was built: §9.7.5 gave it Ctrl+comma, §10.11 said
        the console is "enabled in Settings - Advanced", and DetailsDestinations cited a "§10.13"
        that had never been written. It was filed rather than invented, and §10.13 was written the
        same day (#146).

        §10.13.1 is why this page carries one section. Poll cadences are deliberately not offered -
        §7.3 fixes them and §12 gives the poller sole ownership, so making them user-visible is an
        amendment to two sections rather than a feature. The display time zone lives on the main
        window and §10.14; units are unspecified. The page says so on screen rather than showing
        controls that do nothing.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Settings" />

            <!-- ================================ Advanced =============================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Advanced" />

                    <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               TextWrapping="Wrap"
                               Text="For working out what the receiver is doing, rather than for using it." />

                    <ToggleSwitch x:Name="ConsoleSwitch"
                                  Header="Advanced Console"
                                  OnContent="Shown"
                                  OffContent="Hidden"
                                  AutomationProperties.Name="Show the Advanced Console"
                                  Toggled="OnConsoleToggled" />

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               TextWrapping="Wrap"
                               Text="Adds a page below Settings offering every command in the catalog as a picker, with a transcript of everything sent and received. It changes what is reachable, never what is permitted: the commands this application will not send are absent from the catalog, so they are absent from the console." />

                    <ToggleSwitch x:Name="ExperimentalSwitch"
                                  Header="Undocumented read-only queries"
                                  OnContent="Shown"
                                  OffContent="Hidden"
                                  AutomationProperties.Name="Enable undocumented read-only queries"
                                  Toggled="OnExperimentalToggled" />

                    <!--
                        §8.5's own sentence, verbatim, which #56 requires the toggle to carry. It is
                        quoted rather than paraphrased because every clause of it is a warning: the
                        queries are undocumented, they may answer with nonsense, and - the part a
                        user most needs - nothing is being set.
                    -->
                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               TextWrapping="Wrap"
                               Text="Enable undocumented read-only queries. These are present in the receiver's command parser but absent from the published manual. They may return errors or nonsense. No setting is changed." />

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               TextWrapping="Wrap"
                               Text="Six queries appear on the Diagnostics page, each run only when you click it. There is no way to type one, and the set forms of these nodes are excluded permanently and cannot be enabled here or anywhere else." />
                </StackPanel>
            </Border>

            <!-- ============================== Not built yet ============================ -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Elsewhere for now" />

                    <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               TextWrapping="Wrap"
                               Text="Poll cadences, the display time zone and units are not on this page yet. The time zone is chosen from the main window's clock; the poll cadences are fixed at the intervals the specification sets." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
