<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.SatellitesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:WinZ3805A.ViewModels"
    mc:Ignorable="d">

    <!--
        §10.5. Selection is shared three ways - clicking a marker highlights its row in the tables,
        picking a row rings its marker, and the list alternate below the toggle stays in step with
        both.

        A11Y-11 is the Plot/List toggle on the sky plot card, not the tables. This comment used to
        claim the tables satisfied it. They do not, and the difference is what #60 turns on: the
        tables split one sky across two cards by tracking state and neither carries that state as a
        column, so reading either alone tells you less than the plot does. The list alternate is one
        card, one row per satellite, with the state the marker shape encodes written out - the same
        data in a form that needs no sense of the sky.

        Manage (P1-3, #51) reads both tracking lists from the receiver and offers the five commands
        that change them. It stages nothing: every one goes through its own §8.3 confirmation, so
        closing the dialog sends nothing.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageRoot"
                    Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Stretch"
                    Spacing="{ThemeResource WzSpaceXl}">
                <VisualStateManager.VisualStateGroups>
                    <!--
                        §9.6.1's page margin: WzSpaceXl (24) at Medium and Wide, WzSpaceMd (16) at
                        Compact. WzPageMarginCompactThickness had existed in Spacing.xaml with no
                        consumer since the token layer was written (#316); this is that consumer.

                        AN ADAPTIVE TRIGGER AND NOT CODE. §9.6.1's instruction not to hand-roll
                        breakpoint logic is aimed at NavigationView, which implements its own — but
                        the reasoning carries: a margin decided in a SizeChanged handler is a
                        breakpoint that no longer appears in the markup it governs, and the next
                        person to read this page would have no way to know one existed.

                        The Compact state's threshold is WzExpandedModeThresholdWidth (1024), the
                        same number NavigationView is configured with, so the rail and the margin
                        change together rather than a few pixels apart.

                        NOT REACHABLE ON EVERY MACHINE. §9.6.2 sets the Details minimum at 1024 as a
                        CONTENT size clamped to the display work area, so on a wide monitor at 100%
                        scaling this state cannot be entered by dragging the window - it is for high
                        display scaling, where the same 1024 of content is fewer effective pixels.
                        Which is exactly why it is declarative: a state that cannot be exercised on
                        the hardware to hand must at least be readable.
                    -->
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="{ThemeResource WzExpandedModeThresholdWidth}" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="CompactLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="PageRoot.Padding" Value="{ThemeResource WzPageMarginCompactThickness}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{ThemeResource WzTitleTextStyle}" Text="Satellites" />
                <TextBlock x:Name="CountSummaryText"
                           Grid.Column="1"
                           Style="{ThemeResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           VerticalAlignment="Bottom" />
            </Grid>

            <!--
                §9.6.1's content grid (#345). The cards flow into as many columns as the width
                holds, each going to whichever column is currently SHORTEST - so a tall card sits
                alone while two short ones stack beside it, rather than alternating into a ragged
                pair. Every page was a single StackPanel before this, which meant §9.6.1's Compact
                arrangement at every width and half of a wide window empty.

                The page heading stays outside it: a title is not a card, and it belongs across the
                top rather than in whichever column happened to be shorter.
            -->
            <controls:CardColumns controls:CardEntrance.IsEnabled="True"
                                  ColumnSpacing="{ThemeResource WzSpaceXl}"
                                  RowSpacing="{ThemeResource WzSpaceXl}">
                <!-- ================================ Sky plot =============================== -->

                <!--
                    Named because it is the unit #47 exports. The capture is this Border and everything
                    inside it, which is why the card carries an opaque Background from WzCardStyle - a
                    PNG of a transparent subtree is legible in whichever viewer happens to composite it
                    over the right colour, and unreadable in the rest.
                -->
                <Border x:Name="SkyCard" Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                §9.9's custom sky-plot icon (#320): the polar grid itself, which is the
                                drawing SkyPlotControl below actually makes and which no Fluent glyph
                                has. Raw to assistive technology - the heading beside it already says
                                what the card is, and an icon repeating it aloud is noise.

                                The heading keeps its name and its column; the StackPanel around it is
                                what moved, because SatellitesPage.xaml.cs sets SkyCardHeading.Text as
                                the view toggle changes.
                            -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource WzSpaceXs}"
                                        VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource WzIconSkyPlot}"
                                          Width="16" Height="16"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource WzTextSecondaryBrush}"
                                          AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock x:Name="SkyCardHeading"
                                           Style="{ThemeResource WzBodyStrongTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="Sky plot" />
                            </StackPanel>

                            <!--
                                RadioButtons rather than a ToggleSwitch, matching the Timing page's range
                                selector: two mutually exclusive views, both worth seeing named, and the
                                current one legible without opening anything. It sits before the plot in
                                tab order, which is what #60's "discoverable by keyboard" asks for - a
                                control a keyboard user meets on the way in rather than one they have to
                                already know about.
                            -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource WzSpaceMd}"
                                        AutomationProperties.Name="Sky view">
                                <RadioButton x:Name="PlotViewChoice"
                                             GroupName="SkyView"
                                             Content="Plot"
                                             Checked="OnSkyViewChanged" />
                                <RadioButton x:Name="ListViewChoice"
                                             GroupName="SkyView"
                                             Content="List"
                                             Checked="OnSkyViewChanged" />

                                <!--
                                    Text rather than an icon. §9.9's icon-only rule would be satisfied by
                                    a name and a tooltip, but "export" has no glyph a user reads without
                                    hovering, and this sits beside two labelled radio buttons where a
                                    lone symbol would look like a third view rather than an action.
                                -->
                                <Button x:Name="ExportImageButton"
                                        Content="Save image"
                                        Click="OnExportImageClicked" />
                            </StackPanel>
                        </Grid>

                        <controls:SkyPlotControl x:Name="SkyPlot"
                                                 MaxPlotSize="360"
                                                 AutomationProperties.Name="Sky plot. Arrow keys move between satellites, Enter selects."
                                                 SatelliteInvoked="OnSkyPlotSatelliteInvoked" />

                        <!--
                            A11Y-11's non-spatial alternate. Bound to the same collection the plot draws
                            from, so the two cannot drift apart: every column here is a field of the
                            record the marker was placed from.
                        -->
                        <Grid x:Name="SkyListHeader"
                              ColumnSpacing="{ThemeResource WzSpaceMd}"
                              Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="PRN" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="El" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Az" />
                            <TextBlock x:Name="SkyListStrengthHeader" Grid.Column="3"
                                       Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="State" />
                        </Grid>

                        <ListView x:Name="SkyRows"
                                  SelectionMode="Single"
                                  Visibility="Collapsed"
                                  ItemContainerStyle="{ThemeResource WzDenseListItemStyle}"
                                  AutomationProperties.Name="Satellites, list view"
                                  SelectionChanged="OnSkyRowSelectionChanged">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <!--
                                        §9.8.2's satellite row reorder (#320). The row names
                                        ItemsRepeater; §9.10.1 specifies these tables as ListView, and a
                                        ListView already offers exactly the animation the row asks for -
                                        offset only, no fade, no size change - through its own container
                                        transitions. Switching control to obtain a behaviour the current
                                        one has would be a rewrite in exchange for nothing.

                                        REPOSITION ALONE, deliberately. An AddDeleteThemeTransition would
                                        also fire on the first fill and on every reconnect, and a table
                                        that flies its rows in each time the link comes back is motion on
                                        a window meant to sit still for weeks. What is worth animating is
                                        a satellite CHANGING PLACE as the sky turns, because that is the
                                        one movement that means something.
                                    -->
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="controls:SkyPlotSatellite">
                                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}"
                                          AutomationProperties.Name="{x:Bind Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind PrnText}" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind ElevationText}" />
                                        <TextBlock Grid.Column="2" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind AzimuthText}" />
                                        <controls:SatelliteStrengthBar Grid.Column="3"
                                                                       Strength="{x:Bind SignalStrength}"
                                                                       Kind="{x:Bind Kind}" />
                                        <TextBlock Grid.Column="4" Style="{ThemeResource WzBodyTextStyle}"
                                                   Text="{x:Bind StateText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="SkyPlotEmptyText"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="SkyPlotSelectionText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}" />

                        <!--
                            Present in the export and nowhere else. It is made visible for the duration
                            of the render and collapsed again immediately, because a picture filed as a
                            calibration record has to say when it was taken and under what mask, and the
                            screen does not - the page footer already carries the age, and repeating it
                            permanently inside the card would be a second staleness readout disagreeing
                            with the first one.

                            WzTextSecondaryBrush rather than tertiary: tertiary measured 3.28:1 in Light
                            (#176) and this line is the part of the image a reader is most likely to be
                            squinting at in a printout.
                        -->
                        <TextBlock x:Name="SkyPlotCaptionText"
                                   Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ================================ Tracked ================================ -->
                <Border Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                        <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Tracked" />

                        <Grid ColumnSpacing="{ThemeResource WzSpaceMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="PRN" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="El" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Az" />
                            <TextBlock x:Name="StrengthHeader" Grid.Column="3"
                                       Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" />
                        </Grid>

                        <ListView x:Name="TrackedRows"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{ThemeResource WzDenseListItemStyle}"
                                  AutomationProperties.Name="Tracked satellites"
                                  SelectionChanged="OnTrackedSelectionChanged">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <!--
                                        §9.8.2's satellite row reorder (#320). The row names
                                        ItemsRepeater; §9.10.1 specifies these tables as ListView, and a
                                        ListView already offers exactly the animation the row asks for -
                                        offset only, no fade, no size change - through its own container
                                        transitions. Switching control to obtain a behaviour the current
                                        one has would be a rewrite in exchange for nothing.

                                        REPOSITION ALONE, deliberately. An AddDeleteThemeTransition would
                                        also fire on the first fill and on every reconnect, and a table
                                        that flies its rows in each time the link comes back is motion on
                                        a window meant to sit still for weeks. What is worth animating is
                                        a satellite CHANGING PLACE as the sky turns, because that is the
                                        one movement that means something.
                                    -->
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrackedSatelliteRow">
                                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}"
                                          AutomationProperties.Name="{x:Bind Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind PrnText}" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind ElevationText}" />
                                        <TextBlock Grid.Column="2" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind AzimuthText}" />
                                        <controls:SatelliteStrengthBar Grid.Column="3"
                                                                       Strength="{x:Bind SignalStrength}"
                                                                       Kind="{x:Bind Kind}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="TrackedEmptyText"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ============================== Not tracked ============================== -->
                <Border Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                        <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Not tracked" />

                        <Grid ColumnSpacing="{ThemeResource WzSpaceMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="PRN" />
                            <TextBlock Grid.Column="1" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="El" />
                            <TextBlock Grid.Column="2" Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" Text="Az" />
                        </Grid>

                        <ListView x:Name="NotTrackedRows"
                                  SelectionMode="Single"
                                  ItemContainerStyle="{ThemeResource WzDenseListItemStyle}"
                                  AutomationProperties.Name="Satellites not being tracked"
                                  SelectionChanged="OnNotTrackedSelectionChanged">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <!--
                                        §9.8.2's satellite row reorder (#320). The row names
                                        ItemsRepeater; §9.10.1 specifies these tables as ListView, and a
                                        ListView already offers exactly the animation the row asks for -
                                        offset only, no fade, no size change - through its own container
                                        transitions. Switching control to obtain a behaviour the current
                                        one has would be a rewrite in exchange for nothing.

                                        REPOSITION ALONE, deliberately. An AddDeleteThemeTransition would
                                        also fire on the first fill and on every reconnect, and a table
                                        that flies its rows in each time the link comes back is motion on
                                        a window meant to sit still for weeks. What is worth animating is
                                        a satellite CHANGING PLACE as the sky turns, because that is the
                                        one movement that means something.
                                    -->
                                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PredictedSatelliteRow">
                                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}"
                                          AutomationProperties.Name="{x:Bind Description}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="180" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind PrnText}" />
                                        <TextBlock Grid.Column="1" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind ElevationText}" />
                                        <TextBlock Grid.Column="2" Style="{ThemeResource WzMonoTextStyle}"
                                                   Text="{x:Bind AzimuthText}" />
                                        <TextBlock Grid.Column="3" Style="{ThemeResource WzCaptionTextStyle}"
                                                   Foreground="{ThemeResource WzTextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{x:Bind StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="NotTrackedEmptyText"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ============================ Elevation mask ============================= -->
                <Border Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                        <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Elevation mask" />
                        <TextBlock x:Name="ElevationMaskText" Style="{ThemeResource WzBodyTextStyle}" />

                        <Grid ColumnSpacing="{ThemeResource WzSpaceMd}" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="{ThemeResource WzSpaceXxs}">
                                <NumberBox x:Name="MaskBox"
                                           MinWidth="220"
                                           Header="New mask (degrees)"
                                           SmallChange="1"
                                           SpinButtonPlacementMode="Compact" />
                                <controls:FieldErrorText x:Name="MaskError" />
                            </StackPanel>

                            <Button x:Name="ApplyMaskButton"
                                    Grid.Column="1"
                                    Content="Apply mask"
                                    Style="{ThemeResource WzDestructiveButtonStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0,24,0,0"
                                    IsEnabled="False"
                                    ToolTipService.ToolTip="Send this elevation mask to the receiver"
                                    Click="OnApplyMaskClicked" />
                        </Grid>

                        <controls:CommandOutcomeBar x:Name="MaskOutcome" />

                        <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                                   Foreground="{ThemeResource WzTextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   Text="The elevation mask applies to every satellite. Choosing individual ones is Manage, below." />
                    </StackPanel>
                </Border>

                <!-- ================================= Manage ================================ -->
                <Border Style="{ThemeResource WzCardStyle}">
                    <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                        <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Which satellites" />

                        <TextBlock Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="{ThemeResource WzProseMaxWidth}"
                                   Text="The receiver keeps an inclusion list and an exclusion list. Manage reads both from the receiver and offers the commands that change them, each behind its own confirmation." />

                        <Button x:Name="ManageButton"
                                Content="Manage…"
                                HorizontalAlignment="Left"
                                Click="OnManageClicked" />

                        <controls:CommandOutcomeBar x:Name="ManageOutcome" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FooterText"
                           Style="{ThemeResource WzCaptionTextStyle}"
                           Foreground="{ThemeResource WzTextTertiaryBrush}" />
            </controls:CardColumns>
        </StackPanel>
    </ScrollViewer>
</Page>
