<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinZ3805A.Device.Models"
    mc:Ignorable="d">

    <!--
        §10.9. Clear is tier C and goes through the §8.3 confirmation; the reads are on demand.
        Reading the error queue REMOVES what it returns, which is why it is a button rather than
        something this page does on arrival.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{ThemeResource WzTitleTextStyle}" Text="Diagnostics" />
                <Button x:Name="RefreshButton"
                        Grid.Column="1"
                        Content="Refresh"
                        Click="OnRefreshClicked"
                        VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Read the self-test result and the diagnostic log" />
            </Grid>

            <ProgressRing x:Name="ReadingRing"
                          IsActive="False"
                          Width="20" Height="20"
                          HorizontalAlignment="Left"
                          AutomationProperties.Name="Reading from the receiver" />

            <InfoBar x:Name="FaultBar" IsOpen="False" IsClosable="False" Severity="Error"
                     Title="Could not read from the receiver" />

            <!-- ================================ Self test ============================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceXs}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Self test" />
                    <TextBlock x:Name="SelfTestText" Style="{ThemeResource WzMonoTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Text="This is the result of the last test the receiver ran. Running a new one interrupts normal operation and needs a confirmation dialog, which arrives with §15 step 10." />
                </StackPanel>
            </Border>

            <!-- ============================= Diagnostic log ============================= -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="LogHeaderText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Style="{ThemeResource WzBodyStrongTextStyle}" />

                        <!-- §9.7.4 scopes the command to the card it empties. -->
                        <Button x:Name="ClearLogButton"
                                Grid.Column="1"
                                Content="Clear log"
                                Style="{ThemeResource WzDestructiveButtonStyle}"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Delete every entry in the receiver&apos;s diagnostic log"
                                Click="OnClearLogClicked" />
                    </Grid>

                    <controls:CommandOutcomeBar x:Name="LogOutcome" />

                    <TextBox x:Name="FilterBox"
                             MinWidth="280"
                             HorizontalAlignment="Left"
                             PlaceholderText="Filter entries"
                             TextChanged="OnFilterChanged"
                             AutomationProperties.Name="Filter log entries" />

                    <ItemsControl x:Name="LogRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DiagnosticLogEntry">
                                <TextBlock Style="{ThemeResource WzMonoTextStyle}"
                                           Padding="0,3"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Text="{x:Bind RawText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="LogEmptyText"
                               Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Visibility="Collapsed" />

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Text="Timestamps are on the receiver's own time scale and are subject to the §7.4 week rollover. CSV export arrives with P0-13." />
                </StackPanel>
            </Border>

            <!-- ============================== Error queue =============================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{ThemeResource WzBodyStrongTextStyle}"
                                   VerticalAlignment="Center" Text="Error queue" />
                        <Button x:Name="ReadErrorsButton"
                                Grid.Column="1"
                                Content="Read errors"
                                Click="OnReadErrorsClicked"
                                ToolTipService.ToolTip="Read and empty the receiver's error queue" />
                    </Grid>

                    <TextBlock x:Name="ErrorSummaryText"
                               Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}" />

                    <ItemsControl x:Name="ErrorRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Style="{ThemeResource WzMonoTextStyle}"
                                           Padding="0,3"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"
                                           Text="{x:Bind}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Text="Reading the queue empties it: each read removes the entry it returns. What is shown here is what was read, and it is not re-read on its own." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
