<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.PositionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        §10.6, read-only. Start survey, Adopt computed position and Apply position are all §8.3
        tier C and need the confirmation dialogs of §15 step 10. Copy is not a device command at
        all - it touches the clipboard and nothing else - so it is here.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Position" />

            <!-- ================================ Position =============================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:SeverityPill x:Name="ModePill" Grid.Column="0" />

                        <Button x:Name="CopyButton"
                                Grid.Column="1"
                                Content="Copy"
                                Click="OnCopyClicked"
                                ToolTipService.ToolTip="Copy the position as decimal degrees" />
                    </Grid>

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Latitude" />
                        <TextBlock x:Name="LatitudeText" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Longitude" />
                        <TextBlock x:Name="LongitudeText" Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Height" />
                        <TextBlock x:Name="HeightText" Grid.Row="2" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" IsTextSelectionEnabled="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================= Survey ================================ -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Survey" />

                    <!--
                        Determinate only while a survey is running. An indeterminate bar on a
                        receiver that is holding a position would animate for weeks in the corner
                        of a lab (§9.8.2, §9.13 item 7).
                    -->
                    <ProgressBar x:Name="SurveyProgress"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed"
                                 AutomationProperties.Name="Survey progress" />

                    <TextBlock x:Name="SurveyPercentText" Style="{ThemeResource WzMonoTextStyle}" />

                    <controls:SeverityPill x:Name="SurveyPill" Visibility="Collapsed" />

                    <TextBlock x:Name="SurveyStatusText"
                               Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}" />

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Text="Starting a survey, adopting its result, and setting a position by hand all change what the receiver holds. Each needs a confirmation dialog, and those arrive with §15 step 10." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Style="{ThemeResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
