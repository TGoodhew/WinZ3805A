<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.HoldoverPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        §10.8, read-only. Applying a threshold, forcing holdover, recovering and ignoring the
        recovery limit are all §8.3 tier C, and forcing holdover carries a guard of its own that
        §15 step 10 has to build alongside the dialog.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel controls:CardEntrance.IsEnabled="True"
                    Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Holdover" />

            <!-- ================================= State ================================= -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <controls:SeverityPill x:Name="StatePill" />

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Predicted 24 h uncertainty" />
                        <TextBlock x:Name="PredictedText"
                                   controls:CopyMenu.IsCopyable="True" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Present time error" />
                        <TextBlock x:Name="PresentErrorText"
                                   controls:CopyMenu.IsCopyable="True" Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Duration" />
                        <TextBlock x:Name="DurationText" Grid.Row="2" Grid.Column="1"
                                   Style="{ThemeResource WzBodyTextStyle}" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Waiting reason" />
                        <TextBlock x:Name="WaitingReasonText" Grid.Row="3" Grid.Column="1"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- =============================== Threshold =============================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Thresholds" />

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--
                            Two different receiver settings live on this card, and until #320 they
                            were labelled as though they were one. This row is the receiver's
                            *uncertainty* threshold - the screen's HOLD THR, in microseconds, which
                            the predicted 24 h uncertainty below is compared against. There is no
                            command to set it: the 58503A guide has exactly one threshold command,
                            and it sets the duration limit the editor below sends.
                        -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Uncertainty threshold" />
                        <TextBlock x:Name="ThresholdText"
                                   controls:CopyMenu.IsCopyable="True" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Currently exceeded" />
                        <controls:SeverityPill x:Name="ThresholdPill" Grid.Row="1" Grid.Column="1" />
                    </Grid>

                    <!-- §9.7.4 puts Apply inline with the value it affects. -->
                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="{ThemeResource WzSpaceXxs}">
                            <!--
                                This sets :SYNC:HOLD:DUR:THReshold, which the 58503A guide defines
                                as "the duration (in seconds) which represents a limit against which
                                the elapsed time of holdover is compared", resolution one second -
                                hence the 1 and 60 steps. It is NOT the uncertainty threshold shown
                                above, and its header said only "New threshold (seconds)" until
                                #320, so adjusting it and watching that reading never move was the
                                obvious thing to do and told you nothing.
                            -->
                            <NumberBox x:Name="ThresholdBox"
                                       MinWidth="240"
                                       Header="Holdover duration limit (seconds)"
                                       SmallChange="1"
                                       LargeChange="60"
                                       SpinButtonPlacementMode="Compact" />
                            <controls:FieldErrorText x:Name="ThresholdError" />
                        </StackPanel>

                        <Button x:Name="ApplyThresholdButton"
                                Grid.Column="1"
                                Content="Apply threshold"
                                Style="{ThemeResource WzDestructiveButtonStyle}"
                                VerticalAlignment="Center"
                                Margin="0,24,0,0"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Send this holdover threshold to the receiver"
                                Click="OnApplyThresholdClicked" />
                    </Grid>

                    <controls:CommandOutcomeBar x:Name="ThresholdOutcome" />
                </StackPanel>
            </Border>

            <!-- ============================ Manual control ============================= -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Manual control" />

                    <!--
                        §10.8's warning, kept in full. This is the one place in the application
                        where an action is harmful without being destructive - nothing is lost, but
                        the oscillator's learning is corrupted and takes days to rebuild.
                    -->
                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="Before forcing holdover"
                             Message="Do not force holdover within 24 hours of power-up. Doing so corrupts the SmartClock oscillator learning process, which then takes days to rebuild." />

                    <!--
                        The guard §10.8 puts under that warning. The verdict is a pill rather than
                        a coloured word, so it carries shape and text as well as colour (§9.4.3) -
                        "Unverified" is a third state and not a quieter "Too soon".
                    -->
                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Text="Time since power-up" />

                        <TextBlock x:Name="PowerUpText"
                                   Grid.Column="1"
                                   Style="{ThemeResource WzBodyStrongTextStyle}"
                                   VerticalAlignment="Center" />

                        <controls:SeverityPill x:Name="PowerUpPill" Grid.Column="2" />
                    </Grid>

                    <!-- §9.7.4's card-scoped commands. The row §10.8 draws, in its order. -->
                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceXs}">
                        <Button x:Name="ForceHoldoverButton"
                                Content="Force holdover"
                                Style="{ThemeResource WzDestructiveButtonStyle}"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Stop disciplining to GPS until you recover manually"
                                Click="OnForceHoldoverClicked" />

                        <Button x:Name="RecoverButton"
                                Content="Recover now"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Start recovery and return the receiver toward lock"
                                Click="OnRecoverClicked" />

                        <Button x:Name="IgnoreLimitButton"
                                Content="Ignore recovery limit"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Continue recovery past the point it would normally stop"
                                Click="OnIgnoreLimitClicked" />
                    </StackPanel>

                    <controls:CommandOutcomeBar x:Name="ManualOutcome" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Style="{ThemeResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
