<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        §10.4. Four cards down one column: Synchronization, Holdover Uncertainty, Health Monitor,
        and Oscillator Control. Cards are L2 (§9.3) - 8 px radius, 16 px padding, hairline stroke,
        no shadow. Commands are card-scoped (§9.7.4); there is no page-level CommandBar.

        No ConnectedAnimation from the main window's medallion. §9.8.2 asks for one, but §10.2
        makes Main and Details separate top-level Windows and ConnectedAnimationService is
        per-view - the spec's own reduced-motion fallback is what is achievable.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Overview" />

            <!-- ============================ Synchronization ============================ -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceMd}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Synchronization" />

                    <StackPanel Orientation="Horizontal" Spacing="{ThemeResource WzSpaceMd}">
                        <controls:StatusMedallion x:Name="Medallion"
                                                  Size="Standard"
                                                  VerticalAlignment="Top" />

                        <StackPanel Spacing="{ThemeResource WzSpaceXxs}" VerticalAlignment="Center">
                            <TextBlock x:Name="ModeText" Style="{ThemeResource WzSubtitleTextStyle}" />
                            <TextBlock x:Name="ModeDetailText"
                                       Style="{ThemeResource WzBodyTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" />
                            <controls:SeverityPill x:Name="CoastingPill"
                                                   Severity="Caution"
                                                   Text="coasting"
                                                   Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>

                    <controls:SeverityPill x:Name="OutputsPill" />

                    <!--
                        The three headline figures. Each carries the number, its label, and what the
                        number means - the sub-caption is the whole point of showing TFOM at all.
                    -->
                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="{ThemeResource WzSpaceXxs}">
                            <controls:SeverityPill x:Name="TfomPill" />
                            <TextBlock x:Name="TfomDetailText"
                                       Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="{ThemeResource WzSpaceXxs}">
                            <controls:SeverityPill x:Name="FfomPill" />
                            <TextBlock x:Name="FfomDetailText"
                                       Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="{ThemeResource WzSpaceXxs}">
                            <controls:ReadoutTile x:Name="TimeInterval"
                                                  Label="1 PPS TI"
                                                  Unit="ns"
                                                  DecimalPlaces="1"
                                                  MaxIntegerDigits="5"
                                                  AllowNegative="True"
                                                  Size="Medium" />
                            <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextSecondaryBrush}"
                                       Text="relative to GPS" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================= Holdover uncertainty ========================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Holdover uncertainty" />

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Predicted (24 h)" />
                        <TextBlock x:Name="HoldoverPredictedText"
                                   controls:CopyMenu.IsCopyable="True"
                                   Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Threshold" />
                        <TextBlock x:Name="HoldoverThresholdText"
                                   controls:CopyMenu.IsCopyable="True"
                                   Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Duration" />
                        <TextBlock x:Name="HoldoverDurationText"
                                   Grid.Row="2" Grid.Column="1"
                                   Style="{ThemeResource WzBodyTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================ Health monitor ============================= -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{ThemeResource WzBodyStrongTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="Health monitor" />

                        <!--
                            §9.7.4 scopes commands to the card they affect. *TST? is tier C, so it
                            goes through CommandConfirmation and nowhere else - the button knows
                            the mnemonic and nothing about what running it means.
                        -->
                        <Button x:Name="RunTestButton"
                                Grid.Column="1"
                                Content="Run test"
                                IsEnabled="False"
                                ToolTipService.ToolTip="Run the receiver&apos;s built-in self-test"
                                Click="OnRunTestClicked" />
                    </Grid>

                    <!-- §9.11 puts the result of a card-scoped command at the top of its card. -->
                    <controls:CommandOutcomeBar x:Name="SelfTestOutcome" />

                    <TextBlock x:Name="HealthSummaryText"
                               Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}" />

                    <!--
                        Wraps rather than a fixed grid: the receiver decides how many items it
                        prints, and a layout that assumed the wireframe's six would clip a seventh
                        from a firmware nobody has seen yet. ItemsRepeater because WinUI has no
                        WrapPanel and this project does not take the Toolkit dependency for one.
                    -->
                    <ItemsRepeater x:Name="HealthItems">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200"
                                               MinColumnSpacing="{ThemeResource WzSpaceMd}"
                                               MinRowSpacing="{ThemeResource WzSpaceXs}"
                                               ItemsStretch="None" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ========================== Oscillator control =========================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Oscillator control (EFC)" />

                    <controls:ReadoutTile x:Name="OscillatorControl"
                                          Label="Current"
                                          Unit="%"
                                          DecimalPlaces="2"
                                          MaxIntegerDigits="3"
                                          AllowNegative="True"
                                          Size="Medium" />

                    <!--
                        §10.4's trend (#285). The card carried a placeholder saying this "arrives
                        with the P1 charting work" from the beginning; the charting (#49), the
                        blocker (OQ-5, #38) and the trend store (#50) have all been closed for some
                        time, so it was an unbuilt feature rather than an untidy comment.

                        The range selector is §9.10.2's, with §13's four settings, and it is
                        INDEPENDENT of the Timing page's rather than shared. §10.4 names six hours
                        as this card's default and Timing defaults to one, so a single shared
                        setting would have to discard one of the two specified defaults on every
                        visit. The two surfaces also do different jobs - this one is glanced at,
                        Timing is where a reading is examined.

                        Its own GroupName, not Timing's. RadioButton grouping is per visual tree so
                        the two could not actually collide, but naming it after this page rather
                        than the quantity means the next chart added here does not silently join a
                        group it should not be in.
                    -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="{ThemeResource WzSpaceXs}">
                        <RadioButton x:Name="OverviewRange1h" Content="1 h"
                                     GroupName="OverviewTrendRange"
                                     Checked="OnRangeChanged" Tag="1" />
                        <RadioButton x:Name="OverviewRange6h" Content="6 h"
                                     GroupName="OverviewTrendRange"
                                     Checked="OnRangeChanged" Tag="6" />
                        <RadioButton x:Name="OverviewRange24h" Content="24 h"
                                     GroupName="OverviewTrendRange"
                                     Checked="OnRangeChanged" Tag="24" />
                        <RadioButton x:Name="OverviewRange7d" Content="7 d"
                                     GroupName="OverviewTrendRange"
                                     Checked="OnRangeChanged" Tag="168" />
                    </StackPanel>

                    <!--
                        Same control and the same settings as the Timing page's EFC chart, because
                        it is the same quantity: Anchoring="Data" because EFC does not meaningfully
                        return to zero, MinimumSpan so a flat trace does not get magnified into
                        noise, and Decimals="2".

                        Two, not one. §9.5.3 rule 6 said EFC was 1 dp while §10.4's wireframe showed
                        -16.83 and this chart's sibling had shipped at 2 dp since it was built -
                        at 1 dp, -16.86 and -16.80 render identically, which defeats the one
                        quantity a user watches for small movement. §9.5.3 was amended on
                        29 Aug 2026 to say 2, so all three now agree.

                        Height matches Timing's 140 px, and nothing adaptive is needed: both pages
                        live in the Details window inside the same ScrollViewer over a width-capped
                        StackPanel. §9.6.2's compact and short layouts are the MAIN window's, and
                        this card is not on it.
                    -->
                    <controls:TrendChart x:Name="EfcTrend"
                                         Height="140"
                                         Unit="%"
                                         Anchoring="Data"
                                         MinimumSpan="0.01"
                                         Decimals="2"
                                         AutomationProperties.Name="Oscillator control trend" />

                    <!--
                        Names the shading in words as well as colour (§9.4.3, A11Y-12), and reports
                        the count - a 7-day range drawn from four hours of history looks exactly
                        like one drawn from seven days, and only the count separates them.
                    -->
                    <TextBlock x:Name="TrendSummaryText"
                               Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}" />
                </StackPanel>
            </Border>

            <!-- ============================== Receiver ================================= -->
            <!--
                P0-1: "displays the *IDN? string within 20 s". Nothing displayed it until #320 —
                the identity reached the application log and stopped there, so the criterion was
                met only somewhere nobody had open.

                Last on the page deliberately. §9.1's premise is that the medallion is what the eye
                goes to; this is reference material, read once when you want to know which unit is
                on the bench and never glanced at again. Putting it above the readings would push
                live state down the page to make room for four fields that never change.

                Values in the mono style: a serial number and a firmware revision are identifiers
                to be compared character by character against a label on a case, which is what
                §9.5.3 reserves the monospaced face for.
            -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Receiver" />

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Model" />
                        <TextBlock x:Name="IdentityModelText"
                                   controls:CopyMenu.IsCopyable="True" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Manufacturer" />
                        <TextBlock x:Name="IdentityManufacturerText"
                                   controls:CopyMenu.IsCopyable="True" Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Serial number" />
                        <TextBlock x:Name="IdentitySerialText" Grid.Row="2" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   IsTextSelectionEnabled="True" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Firmware" />
                        <TextBlock x:Name="IdentityFirmwareText" Grid.Row="3" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   IsTextSelectionEnabled="True" />
                    </Grid>

                    <!--
                        Only for a receiver whose answer was not the four fields IEEE 488.2 defines.
                        The rows above would all read "—" then, which says "nothing connected" when
                        what happened is "a model this build has not seen". §11.1 keeps the evidence.
                    -->
                    <TextBlock x:Name="IdentityRawText"
                               Style="{ThemeResource WzMonoTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Style="{ThemeResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
