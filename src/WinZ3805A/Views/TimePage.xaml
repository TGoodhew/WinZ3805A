<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.TimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        §10.14, written after this page rather than before it: §10.2 required the destination and
        no §10.x section described it, so this was built from what the specification does define
        for the data - §7.4's week rollover, §11.2's time fields, #95's display zone - and the gap
        was filed as #111. §10.14 adopted that reading and settled the three questions #111 raised.

        The leap-second card is not finished. §10.14 requires the accumulated GPS-UTC offset, which
        this does not show; #149 carries it.
    -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{ThemeResource WzPageMarginThickness}"
                    MaxWidth="{ThemeResource WzContentMaxWidth}"
                    HorizontalAlignment="Left"
                    Spacing="{ThemeResource WzSpaceXl}">

            <TextBlock Style="{ThemeResource WzTitleTextStyle}" Text="Time" />

            <!-- ================================== Clock ================================ -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Receiver clock" />

                    <TextBlock x:Name="ShownTimeText"
                               Style="{ThemeResource WzReadoutMediumTextStyle}"
                               IsTextSelectionEnabled="True" />

                    <ComboBox x:Name="ZonePicker"
                              MinWidth="320"
                              HorizontalAlignment="Left"
                              Header="Show times in"
                              SelectionChanged="OnZoneSelected" />

                    <Grid RowSpacing="{ThemeResource WzSpaceXs}" ColumnSpacing="{ThemeResource WzSpaceXl}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Time scale" />
                        <TextBlock x:Name="TimeScaleText" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzBodyTextStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="Reported by the receiver" />
                        <TextBlock x:Name="DeviceTimeText" Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" IsTextSelectionEnabled="True" />
                    </Grid>

                    <TextBlock x:Name="TimeScaleNoteText"
                               Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- =============================== Week rollover =========================== -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Week rollover correction" />
                    <controls:SeverityPill x:Name="RolloverPill" />
                    <TextBlock x:Name="RolloverText"
                               Style="{ThemeResource WzBodyTextStyle}"
                               Foreground="{ThemeResource WzTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}" />
                </StackPanel>
            </Border>

            <!-- ================================ Leap second ============================ -->
            <Border Style="{ThemeResource WzCardStyle}">
                <StackPanel Spacing="{ThemeResource WzSpaceSm}">
                    <TextBlock Style="{ThemeResource WzBodyStrongTextStyle}" Text="Leap second" />
                    <controls:SeverityPill x:Name="LeapPill" />

                    <!--
                        §10.14's accumulated offset. Always shown, because it is the one figure on
                        this card that is available on a day when nothing is announced - and it is
                        the number anyone comparing GPS time to UTC actually needs.
                    -->
                    <Grid ColumnSpacing="{ThemeResource WzSpaceMd}" RowSpacing="{ThemeResource WzSpaceXxs}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Text="GPS − UTC" />
                        <TextBlock x:Name="AccumulatedText" Grid.Row="0" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}" />

                        <TextBlock x:Name="AnnouncedLabel" Grid.Row="1" Grid.Column="0"
                                   Style="{ThemeResource WzBodyTextStyle}"
                                   Foreground="{ThemeResource WzTextSecondaryBrush}"
                                   Visibility="Collapsed"
                                   Text="Announced for" />
                        <TextBlock x:Name="AnnouncedDateText" Grid.Row="1" Grid.Column="1"
                                   Style="{ThemeResource WzMonoTextStyle}"
                                   Visibility="Collapsed" />
                    </Grid>

                    <TextBlock x:Name="LeapErrorText"
                               Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Visibility="Collapsed" />

                    <TextBlock Style="{ThemeResource WzCaptionTextStyle}"
                               Foreground="{ThemeResource WzTextTertiaryBrush}"
                               TextWrapping="Wrap"
                               MaxWidth="{ThemeResource WzProseMaxWidth}"
                               Text="The accumulated offset is how far GPS time has run ahead of UTC since 1980. An announced leap second is a step the 1 PPS will take, which anything downstream counting seconds needs to expect." />
                </StackPanel>
            </Border>

            <TextBlock x:Name="FooterText"
                       Style="{ThemeResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
