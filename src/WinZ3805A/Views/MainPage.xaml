<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinZ3805A.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource WzLayerFillBrush}">

    <!--
        Scaffolding, still. The §10.3 main window is a medallion surface and is P0-3; this page
        is what the Frame shows until that lands.

        It carries live references to the §9 token layer and to SeverityPill on purpose. A
        resource dictionary nothing binds to, and a control template nothing instantiates, both
        fail at run time rather than at build time — so a mistyped key or a broken template would
        sit undiscovered until the first real page. Exercising one of each means launching the app
        proves both resolve.

        The pill is not a placeholder: "Not connected" at Neutral severity is the true state of
        this window right now, and §9.13 item 10 requires that it be said through this control
        rather than as a coloured dot.
    -->
    <Grid Padding="{StaticResource WzPageMarginThickness}">
        <Border Style="{StaticResource WzCardStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="{StaticResource WzSpaceXs}">
                <!--
                    Disconnected with no samples, which is the truth right now. It also keeps the
                    medallion template instantiated: a control template nothing creates fails at run
                    time rather than at build time.
                -->
                <controls:StatusMedallion Mode="Disconnected" Size="Standard" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource WzSubtitleTextStyle}"
                           Foreground="{ThemeResource WzTextPrimaryBrush}"
                           Text="No receiver connected" />
                <TextBlock Style="{StaticResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           MaxWidth="{StaticResource WzProseMaxWidth}"
                           TextWrapping="Wrap"
                           Text="Connect a SmartClock receiver over RS-232 to begin monitoring." />
                <controls:SeverityPill Severity="Neutral" Text="Not connected" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
