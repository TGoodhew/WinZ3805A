<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinZ3805A.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource WzLayerFillBrush}">

    <!--
        The §10.3 main window: the surface a lab user leaves on a second monitor for weeks. Its job
        is answered in two seconds from across a room — what state the receiver is in, and how many
        satellites it can see.

        Every colour, size, radius and gap is a §9 token. Severity is never carried by colour alone:
        each one goes through SeverityPill, which adds shape and text (§9.13 item 10).
    -->
    <Grid x:Name="RootGrid"
          Padding="{StaticResource WzPageMarginThickness}"
          RowSpacing="{StaticResource WzSpaceXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A11Y-9's live region. It has no visual job at all: the states it announces are already
            on screen in the medallion, the mode text and the coasting pill, and repeating them
            visibly would be noise. Opacity rather than Visibility.Collapsed, and a real height
            rather than zero, because a collapsed or zero-sized element is pruned out of the
            automation tree and takes the announcement with it.
        -->
        <TextBlock x:Name="Announcer"
                   Grid.Row="0"
                   Height="1"
                   Opacity="0"
                   IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite" />

        <!--
            Medallion and mode. A Grid rather than a horizontal StackPanel, and the text blocks
            wrap: a horizontal StackPanel hands every child its full desired width regardless of
            what is available, so at 200% text scaling the mode text ran past the right edge of a
            380 px window and was cut mid-word by the window itself. A11Y-6 (#26) allows no text to
            clip at any breakpoint. The starred column gives the text somewhere to wrap into, and
            the medallion keeps its natural size in the Auto column.

            Note the UIA tree does NOT show this: a clipped TextBlock still reports a bounding
            rectangle inside its parent, so the overflow is invisible to a bounds check and only a
            rendered capture catches it.
        -->
        <Grid x:Name="HeaderRow" ColumnSpacing="{StaticResource WzSpaceXl}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:StatusMedallion x:Name="Medallion"
                                      Grid.Column="0"
                                      Size="Large"
                                      DoubleTapped="OnMedallionDoubleTapped" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="{StaticResource WzSpaceXxs}">
                <TextBlock x:Name="ModeText"
                           Style="{StaticResource WzSubtitleTextStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource WzTextPrimaryBrush}" />
                <TextBlock x:Name="ModeDetailText"
                           Style="{StaticResource WzBodyTextStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                <controls:SeverityPill x:Name="CoastingPill"
                                       Severity="Caution"
                                       Text="coasting"
                                       Visibility="Collapsed" />

            </StackPanel>
        </Grid>

        <!-- The two figures that share top billing (§10.3) -->
        <StackPanel x:Name="ReadoutRow"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceXxl}">
            <controls:ReadoutTile x:Name="Satellites"
                                  Label="satellites"
                                  Size="Large"
                                  DecimalPlaces="0"
                                  MaxIntegerDigits="2"
                                  AllowNegative="False" />
            <controls:ReadoutTile x:Name="TimeInterval"
                                  Label="1 PPS TI"
                                  Unit="ns"
                                  Size="Large"
                                  DecimalPlaces="1"
                                  MaxIntegerDigits="4" />
        </StackPanel>

        <!-- Figures of merit, through SeverityPill so shape and text travel with the colour -->
        <StackPanel x:Name="MeritRow"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceMd}">
            <controls:SeverityPill x:Name="TfomPill" />
            <controls:SeverityPill x:Name="FfomPill" />
        </StackPanel>

        <!-- Device clock, set in the mono face because it is what the machine said (§9.5.1) -->
        <StackPanel x:Name="ClockRow"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceXxs}"
                    VerticalAlignment="Top">
            <TextBlock x:Name="ClockText"
                       Style="{StaticResource WzMonoTextStyle}"
                       Foreground="{ThemeResource WzTextPrimaryBrush}" />
            <!--
                A11Y-5: pointer targets are >= 32 x 32 px AT ALL TIMES, and §9.10.2's sky-plot
                markers are the one recorded exception. A bare TextBlock is hit-testable only where
                its glyph is, so at FontSize 12 this badge was about 12 x 15 px - under a fifth of
                the required area. It was reachable in practice only by hitting the glyph exactly,
                and the tooltip dismissed the moment the pointer left it.

                THE HOVER FILL IS NOT DECORATION. Enlarging the target fixed where the pointer
                works and left the badge looking exactly as dead as before: the time-zone button
                beside it lights up because it is a Button and gets PointerOver from its template,
                while a Border gets nothing. With a tooltip's delay in front of it, an unlit target
                is indistinguishable from one that is not responding - which is how this was
                reported the second time, after the size was already fixed.

                §9.4.3's colour-plus-shape-plus-text rule does not apply here and the
                colour-only-states gate exempts pointer feedback for the same reason: this conveys
                no information to read, it only says the pointer is where the user thinks it is.

                The Border is what carries the target. Background MUST be Transparent and not left
                unset: an unset Background is null, which is not hit-testable at all, so the padding
                would enlarge the box visually and change nothing about where the pointer works.

                The tooltip and the automation name move onto the Border with the target, so the
                thing a pointer can hit and the thing a screen reader announces are one element.
            -->
            <Border x:Name="RolloverBadge"
                    Background="Transparent"
                    CornerRadius="{ThemeResource WzControlCornerRadius}"
                    MinWidth="32"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    PointerEntered="OnBadgePointerEntered"
                    PointerExited="OnBadgePointerExited"
                    Visibility="Collapsed">

                <!--
                    Declared here rather than attached from code. ToolTipService.SetToolTip
                    on a Border set the value without ever opening a tooltip - the hover
                    fill proved the pointer events were arriving, and no tooltip window was
                    created. Declaring the ToolTip in XAML and updating its Content is what
                    the time-zone button beside these already does, and it works.
                -->
                <ToolTipService.ToolTip>
                    <ToolTip x:Name="RolloverTip" />
                </ToolTipService.ToolTip>

                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource WzInfoBrush}"
                           Text="&#xE946;" />
            </Border>

            <!--
                #245. A separate badge from the rollover one, because both can be in force at once -
                a power-up screen is provisional AND two decades behind - and one glyph doing double
                duty could only say the more alarming of the two.

                WzCautionBrush rather than info: a rollover correction is a known quantity the
                application has already applied, while this reading may be wrong by any amount and
                nothing on the screen says by how much.
            -->
            <Border x:Name="ProvisionalBadge"
                    Background="Transparent"
                    CornerRadius="{ThemeResource WzControlCornerRadius}"
                    MinWidth="32"
                    MinHeight="32"
                    VerticalAlignment="Center"
                    PointerEntered="OnBadgePointerEntered"
                    PointerExited="OnBadgePointerExited"
                    Visibility="Collapsed">

                <!--
                    Declared here rather than attached from code. ToolTipService.SetToolTip
                    on a Border set the value without ever opening a tooltip - the hover
                    fill proved the pointer events were arriving, and no tooltip window was
                    created. Declaring the ToolTip in XAML and updating its Content is what
                    the time-zone button beside these already does, and it works.
                -->
                <ToolTipService.ToolTip>
                    <ToolTip x:Name="ProvisionalTip" />
                </ToolTipService.ToolTip>

                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource WzCautionBrush}"
                           Text="&#xE9CE;" />
            </Border>

            <!--
                The zone picker. Its long-term home is Settings -> Time, a page in the Details
                window (§10.2), which is #5 in M4; until that exists it lives here so the setting is
                reachable at all. Icon-only, so §9.9 requires both an automation name and a tooltip.
            -->
            <!--
                A11Y-5's 32 px floor, which §9.6.3 lists among the ones no mode may reduce. The
                glyph stays 12 px - only the hit area grows, which is what the criterion asks for.
                This measured 20 x 20 until #159; it looked right, and looking right is exactly why
                the gate now checks it rather than a reviewer.
            -->
            <Button x:Name="ZoneButton"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="{StaticResource WzSpaceXxsThickness}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Time zone settings"
                    ToolTipService.ToolTip="Choose the time zone times are shown in">
                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="12"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           Text="&#xE774;" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="360" Spacing="{StaticResource WzSpaceXs}">
                            <TextBlock Style="{StaticResource WzBodyStrongTextStyle}"
                                       Foreground="{ThemeResource WzTextPrimaryBrush}"
                                       Text="Time zone" />
                            <ToggleSwitch x:Name="UseMachineZone"
                                          Header="Use this computer's time zone"
                                          IsOn="True"
                                          Toggled="OnUseMachineZoneToggled" />
                            <ComboBox x:Name="ZonePicker"
                                      Header="Time zone"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="False"
                                      SelectionChanged="OnZoneSelected" />
                            <TextBlock Style="{StaticResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="This changes what is displayed only. The receiver keeps its own time zone setting." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>

        <!-- Footer: what we are talking to, and how old what it said is -->
        <Grid x:Name="FooterRow" Grid.Row="4" ColumnSpacing="{StaticResource WzSpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        Spacing="{StaticResource WzSpaceXxs}"
                        VerticalAlignment="Center">
                <!--
                    A11Y-12's second channel for §10.3's staleness (#32).

                    The states below used to change nothing but FooterText.Foreground, so how old a
                    reading is was carried by hue and nothing else. §9.4.3 says exactly why that
                    fails: caution and critical converge under protanopia and deuteranopia. Under
                    high contrast it is not a convergence but an identity - WzCautionBrush and
                    WzCriticalBrush are both SystemColorWindowTextColor, so the two states render
                    the same pixels.

                    The age in words is in FooterText either way. What was missing is the judgement
                    the colour was making about it, and this carries that: §9.4.3's triangle for
                    caution and hexagon for critical, the same geometry SeverityPill uses, collapsed
                    when the reading is fresh because a fresh reading has nothing to say.
                -->
                <Path x:Name="FooterStalenessShape"
                      Width="10"
                      Height="10"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      AutomationProperties.AccessibilityView="Raw"
                      Data="{ThemeResource WzShapeTriangle}"
                      Fill="{ThemeResource WzCautionBrush}" />

                <TextBlock x:Name="FooterText"
                           Style="{StaticResource WzCaptionTextStyle}"
                           Foreground="{ThemeResource WzTextTertiaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource WzSpaceXs}">
                <Button x:Name="DetailsButton"
                        Content="Details"
                        Click="OnDetailsClicked"
                        ToolTipService.ToolTip="Open the Receiver Details window (Ctrl+D)" />
                <!--
                    §10.3's always-on-top toggle. An icon-only command, so §9.9 requires both a
                    tooltip carrying the label and an AutomationProperties.Name - which the icon gate
                    checks, and which is why the tooltip is written out rather than left to the
                    control.

                    The minimum height is A11Y-5's 32 px floor, which §9.6.3 lists among the ones no
                    mode may reduce. A ToggleButton around a 16 px FontIcon lays out at 29 px on its
                    own - measured, not guessed - so the floor is stated rather than inherited.
                -->
                <ToggleButton x:Name="AlwaysOnTopButton"
                              MinWidth="40"
                              MinHeight="32"
                              AutomationProperties.Name="Keep this window above others"
                              ToolTipService.ToolTip="Keep this window above others"
                              Click="OnAlwaysOnTopClicked">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16"
                              Glyph="&#xE840;" />
                </ToggleButton>

                <Button x:Name="ConnectButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnConnectClicked" />
            </StackPanel>
        </Grid>

        <!--
            §9.11's first-run surface (#253). Spans every row and paints the page background, so it
            covers the medallion rather than sitting beside it - the row says "full-page centred",
            and a medallion reading "Disconnected" beside an invitation to choose a port would be
            answering the same question twice in two voices.

            Collapsed by default and shown only by FirstRun.ShouldShow, which is where the rule
            lives: see there for why first run ends when a port is CHOSEN rather than when one
            connects.

            "No tour, no carousel, no dismissible tips" - §9.11 says so, and this is one screen with
            one action. There is deliberately no close button: it is not a message to acknowledge,
            it is the state of a machine with no receiver configured, and it goes when that changes.
        -->
        <Grid x:Name="FirstRunPanel"
              Grid.Row="0"
              Grid.RowSpan="5"
              Visibility="Collapsed"
              Background="{ThemeResource WzPageBackgroundFallbackBrush}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420"
                        Spacing="{StaticResource WzSpaceMd}">
                <FontIcon Glyph="&#xE8CD;"
                          FontSize="32"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource WzTextSecondaryBrush}" />
                <TextBlock x:Name="FirstRunHeadline"
                           Style="{ThemeResource WzTitleLargeTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="FirstRunBody"
                           Style="{ThemeResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="FirstRunAction"
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="OnFirstRunActionClicked" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <!--
                §10.3's footer staleness. Driven from the view model rather than from a converter so
                the thresholds live in one tested place, and set through ThemeResource so the colours
                re-resolve on a theme change.
            -->
            <VisualStateGroup x:Name="StalenessStates">
                <VisualState x:Name="AgeFresh" />
                <VisualState x:Name="AgeCaution">
                    <VisualState.Setters>
                        <Setter Target="FooterText.Foreground" Value="{ThemeResource WzCautionBrush}" />
                        <Setter Target="FooterStalenessShape.Visibility" Value="Visible" />
                        <Setter Target="FooterStalenessShape.Data" Value="{ThemeResource WzShapeTriangle}" />
                        <Setter Target="FooterStalenessShape.Fill" Value="{ThemeResource WzCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AgeCritical">
                    <VisualState.Setters>
                        <Setter Target="FooterText.Foreground" Value="{ThemeResource WzCriticalBrush}" />
                        <Setter Target="FooterStalenessShape.Visibility" Value="Visible" />
                        <Setter Target="FooterStalenessShape.Data" Value="{ThemeResource WzShapeHexagon}" />
                        <Setter Target="FooterStalenessShape.Fill" Value="{ThemeResource WzCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                §10.3's compact mode, 380 x 120: the medallion drops to 64 px and everything below
                the mode line goes away. Type sizes, targets and focus visuals are unchanged (§9.6.3)
                — this is less content, not smaller content.
            -->
            <VisualStateGroup x:Name="DensityStates">
                <VisualState x:Name="Normal" />
                <!--
                    §9.6.2's main row: at the 380 x 240 minimum the window shows the medallion and
                    the two mode lines, and everything below them is collapsed.

                    Collapsed, not clipped. Before this state existed the rows stayed in the tree
                    and were pushed off the bottom edge, so the Connect and Details buttons were
                    focusable, hit-testable and invisible - an A11Y-1 and A11Y-6 defect rather than
                    a small window. Measured on the built layout, the footer's Connect button does
                    not reach §9.6.3's 32 px pointer floor until 472 effective pixels of content
                    height, which is where MainPage switches.

                    RowSpacing goes with them. A Grid still spaces its row definitions apart when
                    the children in them are collapsed, so leaving it at WzSpaceXl would keep 96 px
                    of gaps for four rows that are no longer there - and that is 96 px out of the
                    240 the medallion has to fit into.
                -->
                <VisualState x:Name="ShortLayout">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.RowSpacing" Value="0" />
                        <Setter Target="ReadoutRow.Visibility" Value="Collapsed" />
                        <Setter Target="MeritRow.Visibility" Value="Collapsed" />
                        <Setter Target="ClockRow.Visibility" Value="Collapsed" />
                        <Setter Target="FooterRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <!--
                    §9.6.2: "Medallion 64 px, mode text and satellite count only; readout row and
                    footer hidden." All four rows go, and the count comes back as text beside the
                    mode. Nothing here changes a type size, a target size or a focus visual -
                    §9.6.3 forbids that, and it is the difference between this and a density switch.
                -->
                <VisualState x:Name="CompactDensity">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.RowSpacing" Value="0" />
                        <Setter Target="Medallion.Size" Value="Compact" />
                        <!--
                            The detail line is not in §9.6.2's list either, and was drawn anyway.
                            That is #215: at 200 % text the column ran past the 144 px minimum and
                            the satellite count — which §9.6.2 DOES require — was pushed offscreen,
                            while the detail line, which it does not, kept its place and was itself
                            clipped to four pixels tall. Collapsing it returns the budget to the two
                            things the specification actually asks for.

                            The mode text still says which state the receiver is in. The detail line
                            qualifies that, and qualifying is what a reduced CONTENT mode gives up.
                        -->
                        <Setter Target="ModeDetailText.Visibility" Value="Collapsed" />
                        <Setter Target="ReadoutRow.Visibility" Value="Collapsed" />
                        <Setter Target="MeritRow.Visibility" Value="Collapsed" />
                        <Setter Target="ClockRow.Visibility" Value="Collapsed" />
                        <Setter Target="CoastingPill.Visibility" Value="Collapsed" />
                        <Setter Target="FooterRow.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
