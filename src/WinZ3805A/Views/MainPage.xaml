<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinZ3805A.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinZ3805A.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WinZ3805A.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource WzLayerFillBrush}">

    <!--
        The §10.3 main window: the surface a lab user leaves on a second monitor for weeks. Its job
        is answered in two seconds from across a room — what state the receiver is in, and how many
        satellites it can see.

        Every colour, size, radius and gap is a §9 token. Severity is never carried by colour alone:
        each one goes through SeverityPill, which adds shape and text (§9.13 item 10).
    -->
    <Grid Padding="{StaticResource WzPageMarginThickness}" RowSpacing="{StaticResource WzSpaceXl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            A11Y-9's live region. It has no visual job at all: the states it announces are already
            on screen in the medallion, the mode text and the coasting pill, and repeating them
            visibly would be noise. Opacity rather than Visibility.Collapsed, and a real height
            rather than zero, because a collapsed or zero-sized element is pruned out of the
            automation tree and takes the announcement with it.
        -->
        <TextBlock x:Name="Announcer"
                   Grid.Row="0"
                   Height="1"
                   Opacity="0"
                   IsHitTestVisible="False"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- Medallion and mode -->
        <StackPanel x:Name="HeaderRow" Orientation="Horizontal" Spacing="{StaticResource WzSpaceXl}">
            <controls:StatusMedallion x:Name="Medallion"
                                      Size="Large"
                                      DoubleTapped="OnMedallionDoubleTapped" />
            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource WzSpaceXxs}">
                <TextBlock x:Name="ModeText"
                           Style="{StaticResource WzSubtitleTextStyle}"
                           Foreground="{ThemeResource WzTextPrimaryBrush}" />
                <TextBlock x:Name="ModeDetailText"
                           Style="{StaticResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}" />
                <controls:SeverityPill x:Name="CoastingPill"
                                       Severity="Caution"
                                       Text="coasting"
                                       Visibility="Collapsed" />

                <!--
                    §9.6.2 gives compact mode "mode text and satellite count only", and the count
                    lives in the readout row that compact mode hides. So it is said again here, in
                    the same words the tile uses and from the same view-model property - one fact,
                    two places to draw it, and no second source to drift from.

                    Not a smaller readout tile: §9.6.3 is explicit that compact is a reduced content
                    mode and not a reduced density one, so this is body text beside body text rather
                    than a shrunken version of anything.
                -->
                <TextBlock x:Name="CompactSatellitesText"
                           Style="{StaticResource WzBodyTextStyle}"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- The two figures that share top billing (§10.3) -->
        <StackPanel x:Name="ReadoutRow"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceXxl}">
            <controls:ReadoutTile x:Name="Satellites"
                                  Label="satellites"
                                  Size="Large"
                                  DecimalPlaces="0"
                                  MaxIntegerDigits="2"
                                  AllowNegative="False" />
            <controls:ReadoutTile x:Name="TimeInterval"
                                  Label="1 PPS TI"
                                  Unit="ns"
                                  Size="Large"
                                  DecimalPlaces="1"
                                  MaxIntegerDigits="4" />
        </StackPanel>

        <!-- Figures of merit, through SeverityPill so shape and text travel with the colour -->
        <StackPanel x:Name="MeritRow"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceMd}">
            <controls:SeverityPill x:Name="TfomPill" />
            <controls:SeverityPill x:Name="FfomPill" />
        </StackPanel>

        <!-- Device clock, set in the mono face because it is what the machine said (§9.5.1) -->
        <StackPanel x:Name="ClockRow"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="{StaticResource WzSpaceXxs}"
                    VerticalAlignment="Top">
            <TextBlock x:Name="ClockText"
                       Style="{StaticResource WzMonoTextStyle}"
                       Foreground="{ThemeResource WzTextPrimaryBrush}" />
            <TextBlock x:Name="RolloverBadge"
                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource WzInfoBrush}"
                       Visibility="Collapsed"
                       Text="&#xE946;" />

            <!--
                The zone picker. Its long-term home is Settings -> Time, a page in the Details
                window (§10.2), which is #5 in M4; until that exists it lives here so the setting is
                reachable at all. Icon-only, so §9.9 requires both an automation name and a tooltip.
            -->
            <!--
                A11Y-5's 32 px floor, which §9.6.3 lists among the ones no mode may reduce. The
                glyph stays 12 px - only the hit area grows, which is what the criterion asks for.
                This measured 20 x 20 until #159; it looked right, and looking right is exactly why
                the gate now checks it rather than a reviewer.
            -->
            <Button x:Name="ZoneButton"
                    MinWidth="32"
                    MinHeight="32"
                    Padding="{StaticResource WzSpaceXxsThickness}"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Time zone settings"
                    ToolTipService.ToolTip="Choose the time zone times are shown in">
                <TextBlock FontFamily="{ThemeResource SymbolThemeFontFamily}"
                           FontSize="12"
                           Foreground="{ThemeResource WzTextSecondaryBrush}"
                           Text="&#xE774;" />
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Width="360" Spacing="{StaticResource WzSpaceXs}">
                            <TextBlock Style="{StaticResource WzBodyStrongTextStyle}"
                                       Foreground="{ThemeResource WzTextPrimaryBrush}"
                                       Text="Time zone" />
                            <ToggleSwitch x:Name="UseMachineZone"
                                          Header="Use this computer's time zone"
                                          IsOn="True"
                                          Toggled="OnUseMachineZoneToggled" />
                            <ComboBox x:Name="ZonePicker"
                                      Header="Time zone"
                                      HorizontalAlignment="Stretch"
                                      IsEnabled="False"
                                      SelectionChanged="OnZoneSelected" />
                            <TextBlock Style="{StaticResource WzCaptionTextStyle}"
                                       Foreground="{ThemeResource WzTextTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="This changes what is displayed only. The receiver keeps its own time zone setting." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

        </StackPanel>

        <!-- Footer: what we are talking to, and how old what it said is -->
        <Grid x:Name="FooterRow" Grid.Row="4" ColumnSpacing="{StaticResource WzSpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterText"
                       Style="{StaticResource WzCaptionTextStyle}"
                       Foreground="{ThemeResource WzTextTertiaryBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource WzSpaceXs}">
                <Button x:Name="DetailsButton"
                        Content="Details"
                        Click="OnDetailsClicked"
                        ToolTipService.ToolTip="Open the Receiver Details window (Ctrl+D)" />
                <!--
                    §10.3's always-on-top toggle. An icon-only command, so §9.9 requires both a
                    tooltip carrying the label and an AutomationProperties.Name - which the icon gate
                    checks, and which is why the tooltip is written out rather than left to the
                    control.

                    The minimum height is A11Y-5's 32 px floor, which §9.6.3 lists among the ones no
                    mode may reduce. A ToggleButton around a 16 px FontIcon lays out at 29 px on its
                    own - measured, not guessed - so the floor is stated rather than inherited.
                -->
                <ToggleButton x:Name="AlwaysOnTopButton"
                              MinWidth="40"
                              MinHeight="32"
                              AutomationProperties.Name="Keep this window above others"
                              ToolTipService.ToolTip="Keep this window above others"
                              Click="OnAlwaysOnTopClicked">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16"
                              Glyph="&#xE840;" />
                </ToggleButton>

                <Button x:Name="ConnectButton"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnConnectClicked" />
            </StackPanel>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <!--
                §10.3's footer staleness. Driven from the view model rather than from a converter so
                the thresholds live in one tested place, and set through ThemeResource so the colours
                re-resolve on a theme change.
            -->
            <VisualStateGroup x:Name="StalenessStates">
                <VisualState x:Name="AgeFresh" />
                <VisualState x:Name="AgeCaution">
                    <VisualState.Setters>
                        <Setter Target="FooterText.Foreground" Value="{ThemeResource WzCautionBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AgeCritical">
                    <VisualState.Setters>
                        <Setter Target="FooterText.Foreground" Value="{ThemeResource WzCriticalBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <!--
                §10.3's compact mode, 380 x 120: the medallion drops to 64 px and everything below
                the mode line goes away. Type sizes, targets and focus visuals are unchanged (§9.6.3)
                — this is less content, not smaller content.
            -->
            <VisualStateGroup x:Name="DensityStates">
                <VisualState x:Name="Normal" />
                <!--
                    §9.6.2: "Medallion 64 px, mode text and satellite count only; readout row and
                    footer hidden." All four rows go, and the count comes back as text beside the
                    mode. Nothing here changes a type size, a target size or a focus visual -
                    §9.6.3 forbids that, and it is the difference between this and a density switch.
                -->
                <VisualState x:Name="CompactDensity">
                    <VisualState.Setters>
                        <Setter Target="Medallion.Size" Value="Compact" />
                        <Setter Target="ReadoutRow.Visibility" Value="Collapsed" />
                        <Setter Target="MeritRow.Visibility" Value="Collapsed" />
                        <Setter Target="ClockRow.Visibility" Value="Collapsed" />
                        <Setter Target="CoastingPill.Visibility" Value="Collapsed" />
                        <Setter Target="FooterRow.Visibility" Value="Collapsed" />
                        <Setter Target="CompactSatellitesText.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
