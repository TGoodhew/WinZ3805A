<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Assembly metadata. Absent until 29 Aug 2026, which left the file properties of a
    shipped binary reading as the project name and nothing else.

    Distinct from the manifest's Publisher distinguished name, which is bound to the
    signing certificate and to package identity (§6.3) and is not set from here.
  -->
  <PropertyGroup>
    <Authors>Tony Goodhew</Authors>
    <Company>The Schanzuer Group LLC</Company>
    <Product>WinZ3805A</Product>
    <Copyright>Copyright (c) 2026 Tony Goodhew</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinZ3805A</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      §6.1: x64 only. No AnyCPU (the Windows App SDK is native), no x86, no
      ARM64 - which is not a deferred build but a platform this project does not
      target (§6.1, amended 29 Aug 2026).
    -->
    <Platforms>x64</Platforms>
    <!--
      The RID follows $(Platform) rather than the building process' architecture,
      which is what the template did. Building an x64 package must not depend on
      what the machine doing the building happens to be.
    -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The token dictionary, embedded as well as compiled. ThemePalette reads the §9 colours out
         of it at run time so that no value from this file is ever restated in C#; a packaged app
         has no Themes/Colors.xaml beside the executable to open, so it travels in the binary. The
         logical name is fixed because the test assembly embeds the same file and must find it
         under the same name. -->
    <EmbeddedResource Include="Themes\Colors.xaml" LogicalName="WinZ3805A.Themes.Colors.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Globbed rather than listed file by file. The logo set is fifty-odd PNGs
      across five scale factors and five target sizes, generated by
      build/New-AppAssets.ps1 from a single mark; a hand-maintained list drifts
      from the generator the first time a size is added, and the symptom is a
      blurry icon on somebody else's display rather than a build error.
    -->
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\AppIcon.ico" />
    <!--
      The user's guide, shipped inside the package so F1 works on a bench machine with no
      internet (#312). The document and its images are the ones under docs/, linked rather
      than copied, so the guide a visitor reads on github.com and the one the application
      shows are the same bytes. HelpWindow reads them from AppContext.BaseDirectory\Help -
      CopyToOutputDirectory is what puts a linked item there for the loose layout winapp
      runs; the MSIX carries Content items regardless.
    -->
    <Content Include="..\..\docs\how-to-use.md" Link="Help\how-to-use.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\how-to-use\*.png" Link="Help\images\how-to-use\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!--
      §9.5.1: Cascadia Mono is embedded rather than assumed present. It is inbox on
      Windows 11 but ships with Windows Terminal, so it cannot be relied on for the
      Windows 10 floor in §6.1. SIL OFL 1.1 permits the redistribution; the licence
      text ships beside the font and is reproduced in THIRD-PARTY-NOTICES.md.
      Referenced as ms-appx:///Assets/Fonts/CascadiaMono.ttf#Cascadia Mono.
    -->
    <Content Include="Assets\Fonts\CascadiaMono.ttf" />
    <Content Include="Assets\Fonts\CascadiaMono-OFL.txt" />
    <!--
      The notices file ships too: the MIT, BSD-2-Clause and Apache-2.0 licences of the
      assemblies in the package each require their notice to accompany a binary
      redistribution, and the OFL text beside the font covers only the font (#316).
    -->
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <!--
      §6.1's stack table, as amended 15 Aug 2026, minus four entries that were
      referenced and never used. Each removal is one line to undo, and each is
      recorded in §6.1 rather than only here:

        CommunityToolkit.Mvvm                  zero usages. The eleven view
                                               models hand-write INotifyProperty-
                                               Changed and should keep doing so;
                                               see §6.1's MVVM row for why.
        Microsoft.Data.Sqlite                  zero usages, and 1.89 MB of native
                                               e_sqlite3.dll in every package for
                                               a feature (#50, P1) no code path
                                               could reach. #50 restores it.
        Microsoft.Extensions.Hosting           zero usages. App.Compose() builds a
                                               ServiceProvider directly and never
                                               a host.

      CommunityToolkit.WinUI.Controls.SettingsControls also has zero usages and
      is KEPT. §9.10's component inventory specifies SettingsCard and
      SettingsExpander by name for the Settings page, which is a required §10.2
      destination and still a placeholder, and the whole package measures 0.31 MB
      of the bundle (15.70 against 15.39). Removing it to re-add it with the page
      would trade that for churn. Sqlite went because 1.89 MB of *native* code is
      a different order of cost, not because the two cases differ in principle.

      Note §9.10 also lists those controls for the Timing and Holdover pages,
      which are built and do not use them. That divergence is real and is a
      design-system question rather than a packaging one; it is not settled here.

      Microsoft.Extensions.Logging stays: ILogger is injected into the transport,
      the session and the poller, and Device/Transport/TransportLog.cs holds real
      LoggerMessage source-generated instrumentation. Nothing configures a
      provider yet, so it all resolves to NullLogger - that is a missing feature
      rather than a dead reference, and it is tracked as #127.
    -->
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <!--
      Restored by P1-2 (#50), exactly as #128 said it would be. It was removed on
      15 Aug 2026 because it had zero usages and was carrying 1.89 MB of native
      e_sqlite3.dll into every package for a feature no code path could reach;
      TrendStore is that code path.
    -->
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.5.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />

    <!--
      Windows App SDK 2.x is modular, and the Microsoft.WindowsAppSDK
      meta-package depends on every module including the ones this application
      has no use for. Left alone, the machine-learning module's native assets are
      copied into the payload: measured on the 2.3.1 Release package,
      onnxruntime.dll (20.7 MB) and DirectML.dll (17.8 MB) alone came to 38 MB of
      a 100 MB payload - the two largest files in the package, and neither
      reachable from any code path here.

      §6.3 asks for framework-dependent deployment because it "keeps the
      submission small"; shipping a machine-learning runtime that an instrument
      monitor never calls is that same concern arriving through another door. The
      manifest already refuses the template's systemAIModels capability for the
      neighbouring reason.

      The exclusion is aimed at Microsoft.Windows.AI.MachineLearning rather than
      at Microsoft.WindowsAppSDK.ML above it, because that is the package whose
      runtimes/ folder actually carries the two DLLs. Excluding .ML itself does
      not work and is worth not retrying: .ML sets the flag that
      Microsoft.Windows.AI.MachineLearning's own targets check, and
      ExcludeAssets="all" drops the build assets that set it, so the build then
      fails on "Framework-dependent apps using WindowsAppSDK must reference
      Microsoft.WindowsAppSDK.ML" - a package excluding itself into its own
      guard. Only the runtime and native assets are excluded here, leaving those
      targets in place.

      The meta-package is deliberately still the reference §6.1 pins: its version
      is the one number identifying the SDK release, and naming the six wanted
      modules instead would mean re-deriving that list every time it moves.
    -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.1.74" ExcludeAssets="runtime;native" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" ExcludeAssets="runtime;native" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinZ3805A.Device\WinZ3805A.Device.csproj" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <!--
      §6.4 forbids trimming: WinUI 3 resolves XAML types by reflection, so a
      trimmed build raises MissingMethodException at runtime and only in the
      packaged configuration. The template defaulted this to True for Release;
      it is pinned False here for every configuration. Do not re-enable it.
      Native AOT is likewise unsupported and must not be added.
    -->
    <PublishTrimmed>false</PublishTrimmed>

    <!--
      PublishReadyToRun deliberately lives in Properties/PublishProfiles/*.pubxml
      rather than here. The template set it for every non-Debug configuration,
      which made an ordinary `Release` *build* fail with NETSDK1094 unless the
      crossgen runtime pack had been restored with the flag already set - a trap
      for a fresh clone and for CI.
    -->
  </PropertyGroup>
</Project>