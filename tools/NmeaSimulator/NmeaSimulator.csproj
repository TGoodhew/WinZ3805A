<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tutorial's receiver on the bench (#310): a GPS talker made of sentences. Run it into one
    end of a serial-port pair and point the packaged application at the other, or reference it
    from the test project and drive it in-process. It depends on the Device library for the
    sentence codec and nothing else; the driver does not depend on it at all - a reader who wants
    only the driver copies src/WinZ3805A.Device/Drivers/Nmea and never sees this folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinZ3805A.Simulation</RootNamespace>
    <AssemblyName>NmeaSimulator</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinZ3805A.Device\WinZ3805A.Device.csproj" />
  </ItemGroup>

</Project>
