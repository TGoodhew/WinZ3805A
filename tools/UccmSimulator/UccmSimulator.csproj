<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A UCCM module on the bench that is not on the bench (#416). It exists because the driver was
    written from a third party's source with no hardware to check it against, so without this there
    is nothing between "the parsers read strings correctly" and "plug in a receiver and hope".

    It is a MODEL OF A BELIEF, not a receiver. Every behaviour it reproduces is one this project
    believes a UCCM has, and the whole point of running the driver against it is that when a real
    module disagrees, the disagreement is specific and cheap to find. Depends on the Device library
    for nothing but the time code writer's shape; the driver does not depend on it at all.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinZ3805A.Simulation</RootNamespace>
    <AssemblyName>UccmSimulator</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinZ3805A.Device\WinZ3805A.Device.csproj" />
  </ItemGroup>

</Project>
