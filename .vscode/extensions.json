    // Enforces the repository .editorconfig.
    "editorconfig.editorconfig",

    // CI workflow authoring.
    "github.vscode-github-actions",

    // XAML formatting - attribute ordering and wrapping. Framework-agnostic.
    "dabbinavo.xamlstyler",

    // WinUI 3 XAML design surface, native preview, MSIX debug and packaging.
    // Preview-quality and community-published, not a Microsoft extension.
    "alvinashcraft.windev-helper"
